@model AmoozeshFront.Models.Auth.LoginViewModel
@{
    ViewData["Title"] = "ورود به سیستم";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سامانه مرکز آموزش وزارت صمت</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Bootstrap RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Vazirmatn', sans-serif;
            min-height: 100vh;
            background: #f0f4f8; /* پس‌زمینه ملایم اداری */
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 20px;
        }

        /* پس‌زمینه با گرادیان ملایم و خطوط هندسی (حس شرکتی) */
        .bg-corporate {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            z-index: 0;
        }

        /* المان‌های تزئینی هندسی (خطوط و دایره‌های کم‌رنگ) */
        .bg-shapes {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            overflow: hidden;
            opacity: 0.15;
        }

            .bg-shapes .shape {
                position: absolute;
                border: 2px solid #1a3a5c;
                border-radius: 50%;
                opacity: 0.5;
            }

                .bg-shapes .shape:nth-child(1) {
                    width: 600px;
                    height: 600px;
                    top: -200px;
                    right: -200px;
                }

                .bg-shapes .shape:nth-child(2) {
                    width: 400px;
                    height: 400px;
                    bottom: -100px;
                    left: -100px;
                    border-color: #c9a84c;
                }

                .bg-shapes .shape:nth-child(3) {
                    width: 200px;
                    height: 200px;
                    top: 30%;
                    left: 10%;
                    border-style: dashed;
                }

        /* Wrapper اصلی */
        .login-wrapper {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 480px;
            animation: fadeInUp 0.8s ease-out;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* کارت ورود با طراحی مینیمال و اداری */
        .login-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 50px 45px 45px;
            box-shadow: 0 25px 60px rgba(26, 58, 92, 0.12), 0 10px 20px rgba(0, 0, 0, 0.02);
            border: 1px solid rgba(26, 58, 92, 0.06);
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

            .login-card:hover {
                box-shadow: 0 35px 80px rgba(26, 58, 92, 0.16);
                transform: translateY(-4px);
            }

        /* هدر با لوگو و عنوان */
        .login-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .logo-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .logo-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(145deg, #1a3a5c, #2a5a8c);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #c9a84c;
            font-size: 30px;
            box-shadow: 0 8px 20px rgba(26, 58, 92, 0.2);
        }

        .logo-text {
            text-align: right;
        }

            .logo-text h1 {
                font-size: 22px;
                font-weight: 800;
                color: #1a3a5c;
                margin: 0;
                line-height: 1.3;
                letter-spacing: -0.5px;
            }

            .logo-text span {
                font-size: 13px;
                font-weight: 300;
                color: #6c7a89;
                display: block;
            }

        .login-header .subtitle {
            color: #6c7a89;
            font-size: 14px;
            font-weight: 300;
            margin-top: 6px;
            border-top: 1px solid #e9edf2;
            padding-top: 12px;
        }

        /* فرم و فیلدها */
        .form-group {
            margin-bottom: 22px;
        }

            .form-group label {
                color: #2c3e50;
                font-size: 13px;
                font-weight: 600;
                margin-bottom: 6px;
                display: block;
            }

        .input-wrapper {
            position: relative;
        }

            .input-wrapper .input-icon {
                position: absolute;
                right: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: #a0b0c0;
                font-size: 16px;
                transition: all 0.2s ease;
                pointer-events: none;
            }

        .form-group .form-control {
            width: 100%;
            padding: 14px 48px 14px 18px;
            font-size: 14px;
            border: 2px solid #e9edf2;
            border-radius: 14px;
            background: #fafbfc;
            color: #1a2a3a;
            transition: all 0.3s ease;
            font-family: 'Vazirmatn', sans-serif;
            height: 54px;
        }

            .form-group .form-control::placeholder {
                color: #b0c0d0;
                font-weight: 300;
            }

            .form-group .form-control:focus {
                border-color: #1a3a5c;
                background: #ffffff;
                box-shadow: 0 0 0 4px rgba(26, 58, 92, 0.06);
                outline: none;
            }

                .form-group .form-control:focus ~ .input-icon,
                .form-group .form-control:focus + .input-icon {
                    color: #1a3a5c;
                }

            .form-group .form-control.is-invalid {
                border-color: #e74c3c;
            }

        .text-danger {
            color: #e74c3c !important;
            font-size: 12px;
            margin-top: 6px;
            display: block;
            font-weight: 400;
        }

        /* چک‌باکس Remember Me */
        .form-check {
            margin-bottom: 28px;
            display: flex;
            align-items: center;
        }

        .form-check-input {
            width: 20px;
            height: 20px;
            border-radius: 6px;
            border: 2px solid #d0d8e0;
            background: #fff;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-left: 10px;
            position: relative;
            flex-shrink: 0;
        }

            .form-check-input:checked {
                background: #1a3a5c;
                border-color: #1a3a5c;
            }

                .form-check-input:checked::before {
                    content: '✓';
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    color: #fff;
                    font-weight: 700;
                    font-size: 13px;
                }

        .form-check-label {
            color: #3d5166;
            font-size: 14px;
            font-weight: 400;
            cursor: pointer;
            user-select: none;
        }

        /* دکمه ورود (با رنگ شرکتی) */
        .btn-login {
            width: 100%;
            padding: 16px;
            font-size: 15px;
            font-weight: 700;
            border: none;
            border-radius: 14px;
            background: #1a3a5c;
            color: #ffffff;
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            font-family: 'Vazirmatn', sans-serif;
            height: 56px;
            position: relative;
            overflow: hidden;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

            .btn-login i {
                font-size: 18px;
                transition: transform 0.3s ease;
            }

            .btn-login:hover {
                background: #0f2a44;
                transform: translateY(-2px);
                box-shadow: 0 12px 30px rgba(26, 58, 92, 0.25);
            }

            .btn-login:active {
                transform: translateY(0px);
                box-shadow: 0 4px 12px rgba(26, 58, 92, 0.2);
            }

            .btn-login:hover i {
                transform: translateX(-4px);
            }

        /* خلاصه خطاها */
        .validation-summary-errors {
            background: #fef6f6;
            border: 1px solid #f5d0d0;
            border-radius: 12px;
            padding: 10px 16px;
            margin-bottom: 22px;
        }

            .validation-summary-errors ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

                .validation-summary-errors ul li {
                    color: #e74c3c;
                    font-size: 13px;
                    padding: 2px 0;
                }

        /* فوتر و لینک‌ها */
        .login-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 28px;
            padding-top: 18px;
            border-top: 1px solid #eef2f6;
        }

            .login-footer a {
                color: #5a7a9a;
                text-decoration: none;
                font-size: 13px;
                font-weight: 400;
                transition: all 0.2s ease;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .login-footer a:hover {
                    color: #1a3a5c;
                }

            .login-footer .copyright {
                color: #8a9aaa;
                font-size: 12px;
                font-weight: 300;
            }

        /* واکنش‌گرایی */
        @@media (max-width: 576px) {
            .login-card {
                padding: 30px 20px 25px;
                border-radius: 20px;
            }

            .logo-icon {
                width: 50px;
                height: 50px;
                font-size: 24px;
            }

            .logo-text h1 {
                font-size: 18px;
            }

            .form-group .form-control {
                height: 50px;
                padding: 12px 44px 12px 14px;
                font-size: 14px;
            }

            .btn-login {
                height: 50px;
                font-size: 14px;
            }

            .login-footer {
                flex-direction: column;
                gap: 10px;
                align-items: center;
            }
        }

        /* اسکرول‌بار */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f0f4f8;
        }

        ::-webkit-scrollbar-thumb {
            background: #c9a84c;
            border-radius: 10px;
        }
    </style>
</head>
<body>

    <!-- پس‌زمینه -->
    <div class="bg-corporate"></div>
    <div class="bg-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <!-- فرم ورود -->
    <div class="login-wrapper">
        <div class="login-card">

            <!-- هدر -->
            <div class="login-header">
                <div class="logo-wrapper">
                    <div class="logo-icon">
                        <i class="fas fa-university"></i>
                    </div>
                    <div class="logo-text">
                        <h1>مرکز آموزش</h1>
                        <span>وزارت صنعت، معدن و تجارت</span>
                    </div>
                </div>
                <div class="subtitle">
                    <i class="fas fa-user-lock" style="color:#c9a84c; margin-left:6px;"></i>
                    برای ورود، نام کاربری و رمز عبور خود را وارد کنید
                </div>
            </div>

            <!-- فرم -->
            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="form-group">
                    <label>نام کاربری</label>
                    <div class="input-wrapper">
                        <input asp-for="Username" class="form-control" placeholder="نام کاربری خود را وارد کنید" autocomplete="username" autofocus />
                        <i class="fas fa-user input-icon"></i>
                    </div>
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>رمز عبور</label>
                    <div class="input-wrapper">
                        <input asp-for="Password" class="form-control" placeholder="رمز عبور خود را وارد کنید" autocomplete="current-password" />
                        <i class="fas fa-lock input-icon"></i>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">مرا به خاطر بسپار</label>
                </div>

                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt"></i> ورود به سامانه
                </button>
            </form>

            <!-- فوتر -->
            <div class="login-footer">
                <a href="#"><i class="fas fa-headset"></i> پشتیبانی</a>
                <a href="#"><i class="fas fa-question-circle"></i> راهنمای ورود</a>
                <span class="copyright">© ۱۴۰۴ - تمامی حقوق محفوظ است</span>
            </div>

        </div>
    </div>

    <!-- اسکریپت‌ها -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // نمایش/مخفی کردن رمز عبور (شکیل و اداری)
            const passwordInput = document.querySelector('input[name="Password"]');
            if (passwordInput) {
                const wrapper = passwordInput.closest('.input-wrapper');
                const toggleBtn = document.createElement('i');
                toggleBtn.className = 'far fa-eye input-icon';
                toggleBtn.style.cssText = 'cursor: pointer; right: 48px; color: #a0b0c0; transition: all 0.2s ease; pointer-events: auto;';
                toggleBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    this.className = type === 'password' ? 'far fa-eye input-icon' : 'far fa-eye-slash input-icon';
                    this.style.color = type === 'password' ? '#a0b0c0' : '#1a3a5c';
                });
                wrapper.appendChild(toggleBtn);
            }
        });
    </script>
</body>
</html>