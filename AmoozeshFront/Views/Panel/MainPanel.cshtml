@{
    ViewData["Title"] = "پنل اصلی";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سامانه آموزش</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Bootstrap RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Vazirmatn', sans-serif;
            min-height: 100vh;
            background: #0a0a0a;
            position: relative;
            overflow-x: hidden;
        }

        /* Animated Background */
        .gradient-bg {
            position: fixed;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, #ffd700, #ff6b35, #ff1493, #ffd700);
            animation: rotate 20s linear infinite;
            opacity: 0.05;
            z-index: 0;
        }

        @@keyframes rotate {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: 0;
            animation: orbFloat 15s ease-in-out infinite;
        }

        .orb-1 {
            width: 400px;
            height: 400px;
            background: #ffd700;
            top: -100px;
            right: -100px;
            opacity: 0.1;
        }

        .orb-2 {
            width: 300px;
            height: 300px;
            background: #ff6b35;
            bottom: -100px;
            left: -100px;
            opacity: 0.1;
            animation-delay: -5s;
        }

        @@keyframes orbFloat {
            0%, 100% {
                transform: translate(0, 0) scale(1);
            }

            25% {
                transform: translate(50px, -50px) scale(1.1);
            }

            50% {
                transform: translate(-30px, 30px) scale(0.9);
            }

            75% {
                transform: translate(30px, 50px) scale(1.05);
            }
        }

        /* Particles */
        #particles-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        /* Main Container */
        .main-container {
            position: relative;
            z-index: 1;
            padding: 30px 20px;
            min-height: 100vh;
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 30px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border-radius: 30px;
            border: 1px solid rgba(255, 215, 0, 0.1);
            margin-bottom: 40px;
            animation: slideDown 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        @@keyframes slideDown {
            0% {
                opacity: 0;
                transform: translateY(-50px) scale(0.9);
            }

            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .header-logo {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #ffd700, #ff6b35);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 30px rgba(255, 215, 0, 0.2);
        }

            .header-logo i {
                font-size: 28px;
                color: #0a0a0a;
            }

        .header-title h2 {
            color: #fff;
            font-weight: 700;
            margin: 0;
            font-size: 22px;
        }

        .header-title p {
            color: rgba(255, 255, 255, 0.4);
            font-size: 13px;
            margin: 0;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .header-date {
            color: rgba(255, 255, 255, 0.5);
            font-size: 14px;
            padding: 8px 18px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .header-user {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 18px 8px 12px;
            background: rgba(255, 215, 0, 0.05);
            border-radius: 50px;
            border: 1px solid rgba(255, 215, 0, 0.1);
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .header-user:hover {
                background: rgba(255, 215, 0, 0.1);
                border-color: rgba(255, 215, 0, 0.3);
            }

            .header-user .avatar {
                width: 38px;
                height: 38px;
                background: linear-gradient(135deg, #ffd700, #ff6b35);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                color: #0a0a0a;
                font-size: 16px;
            }

            .header-user .user-info {
                color: #fff;
            }

                .header-user .user-info .name {
                    font-weight: 600;
                    font-size: 14px;
                }

                .header-user .user-info .role {
                    font-size: 12px;
                    color: rgba(255, 255, 255, 0.4);
                }

        /* Welcome Section */
        .welcome-section {
            margin-bottom: 40px;
            animation: fadeUp 1s ease-out 0.2s both;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .welcome-section h1 {
            color: #fff;
            font-weight: 800;
            font-size: 32px;
            margin-bottom: 5px;
        }

            .welcome-section h1 span {
                background: linear-gradient(90deg, #ffd700, #ff6b35);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .welcome-section p {
            color: rgba(255, 255, 255, 0.4);
            font-size: 16px;
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
            animation: fadeUp 1s ease-out 0.3s both;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            position: relative;
            overflow: hidden;
        }

            .stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                border-radius: 20px 20px 0 0;
            }

            .stat-card:hover {
                transform: translateY(-5px);
                border-color: rgba(255, 215, 0, 0.2);
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            }

            .stat-card:nth-child(1)::before {
                background: linear-gradient(90deg, #ffd700, #ff6b35);
            }

            .stat-card:nth-child(2)::before {
                background: linear-gradient(90deg, #00d2ff, #3a7bd5);
            }

            .stat-card:nth-child(3)::before {
                background: linear-gradient(90deg, #11998e, #38ef7d);
            }

            .stat-card:nth-child(4)::before {
                background: linear-gradient(90deg, #fc4a1a, #f7b733);
            }

            .stat-card .stat-icon {
                width: 50px;
                height: 50px;
                border-radius: 15px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                margin-bottom: 15px;
            }

            .stat-card:nth-child(1) .stat-icon {
                background: rgba(255, 215, 0, 0.15);
                color: #ffd700;
            }

            .stat-card:nth-child(2) .stat-icon {
                background: rgba(0, 210, 255, 0.15);
                color: #00d2ff;
            }

            .stat-card:nth-child(3) .stat-icon {
                background: rgba(17, 153, 142, 0.15);
                color: #11998e;
            }

            .stat-card:nth-child(4) .stat-icon {
                background: rgba(252, 74, 26, 0.15);
                color: #fc4a1a;
            }

            .stat-card .stat-number {
                color: #fff;
                font-size: 28px;
                font-weight: 800;
            }

            .stat-card .stat-label {
                color: rgba(255, 255, 255, 0.4);
                font-size: 14px;
            }

        /* Main Cards Grid */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 25px;
            animation: fadeUp 1s ease-out 0.4s both;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border-radius: 30px;
            padding: 40px 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            position: relative;
            overflow: hidden;
            cursor: pointer;
            min-height: 300px;
            display: flex;
            flex-direction: column;
        }

            .feature-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                border-radius: 30px;
                opacity: 0;
                transition: all 0.5s ease;
            }

            .feature-card:hover {
                transform: translateY(-10px) scale(1.02);
                border-color: rgba(255, 215, 0, 0.3);
                box-shadow: 0 40px 80px rgba(0, 0, 0, 0.5);
            }

                .feature-card:hover::before {
                    opacity: 1;
                }

            /* Card 1 - تعریف اطلاعات پایه */
            .feature-card:nth-child(1) {
                border-color: rgba(255, 215, 0, 0.1);
            }

                .feature-card:nth-child(1)::before {
                    background: radial-gradient(circle at 0% 0%, rgba(255, 215, 0, 0.05), transparent 70%);
                }

                .feature-card:nth-child(1) .card-icon {
                    background: linear-gradient(135deg, #ffd700, #ff6b35);
                    box-shadow: 0 15px 40px rgba(255, 215, 0, 0.3);
                }

            /* Card 2 - صدور مدرک */
            .feature-card:nth-child(2) {
                border-color: rgba(0, 210, 255, 0.1);
            }

                .feature-card:nth-child(2)::before {
                    background: radial-gradient(circle at 0% 0%, rgba(0, 210, 255, 0.05), transparent 70%);
                }

                .feature-card:nth-child(2) .card-icon {
                    background: linear-gradient(135deg, #00d2ff, #3a7bd5);
                    box-shadow: 0 15px 40px rgba(0, 210, 255, 0.3);
                }

            /* Card 3 - سیستم دانشجویی */
            .feature-card:nth-child(3) {
                border-color: rgba(17, 153, 142, 0.1);
            }

                .feature-card:nth-child(3)::before {
                    background: radial-gradient(circle at 0% 0%, rgba(17, 153, 142, 0.05), transparent 70%);
                }

                .feature-card:nth-child(3) .card-icon {
                    background: linear-gradient(135deg, #11998e, #38ef7d);
                    box-shadow: 0 15px 40px rgba(17, 153, 142, 0.3);
                }

        .card-icon {
            width: 70px;
            height: 70px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: #fff;
            margin-bottom: 25px;
            transition: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        .feature-card:hover .card-icon {
            transform: rotate(-10deg) scale(1.1);
        }

        .feature-card .card-content {
            flex: 1;
        }

            .feature-card .card-content h3 {
                color: #fff;
                font-size: 22px;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .feature-card .card-content p {
                color: rgba(255, 255, 255, 0.4);
                font-size: 14px;
                line-height: 1.8;
                margin-bottom: 20px;
            }

        .feature-card .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

            .feature-card .card-footer .card-link {
                color: rgba(255, 255, 255, 0.4);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .feature-card .card-footer .card-link i {
                    transition: transform 0.3s ease;
                }

        .feature-card:hover .card-footer .card-link {
            color: #ffd700;
        }

            .feature-card:hover .card-footer .card-link i {
                transform: translateX(-5px);
            }

        .feature-card .card-status {
            padding: 5px 15px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 600;
            background: rgba(46, 213, 115, 0.1);
            color: #2ed573;
            border: 1px solid rgba(46, 213, 115, 0.2);
        }

        .feature-card:nth-child(2) .card-status {
            background: rgba(255, 215, 0, 0.1);
            color: #ffd700;
            border-color: rgba(255, 215, 0, 0.2);
        }

        .feature-card:nth-child(3) .card-status {
            background: rgba(0, 210, 255, 0.1);
            color: #00d2ff;
            border-color: rgba(0, 210, 255, 0.2);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .header {
                flex-direction: column;
                align-items: stretch;
                gap: 15px;
                padding: 20px;
            }

            .header-left {
                justify-content: space-between;
                flex-wrap: wrap;
            }

            .header-right {
                justify-content: center;
            }

            .header-title h2 {
                font-size: 18px;
            }

            .welcome-section h1 {
                font-size: 24px;
            }

            .cards-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .stat-card .stat-number {
                font-size: 22px;
            }

            .header-date {
                display: none;
            }
        }

        @@media (max-width: 480px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .feature-card {
                padding: 30px 20px;
                min-height: auto;
            }

            .main-container {
                padding: 15px;
            }
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #0a0a0a;
        }

        ::-webkit-scrollbar-thumb {
            background: #ffd700;
            border-radius: 10px;
        }
    </style>
</head>
<body>

    <!-- Background -->
    <div class="gradient-bg"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <canvas id="particles-canvas"></canvas>

    <!-- Main Container -->
    <div class="main-container">

        <!-- Header -->
        <header class="header">
            <div class="header-right">
                <div class="header-logo">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <div class="header-title">
                    <h2>سامانه آموزش</h2>
                    <p>پنل مدیریت</p>
                </div>
            </div>
            <div class="header-left">
                <div class="header-date">
                    <i class="far fa-calendar-alt"></i>
                    <span id="currentDate"></span>
                </div>
                <div class="header-user">
                    <div class="avatar">ا</div>
                    <div class="user-info">
                        <div class="name">مدیر سیستم</div>
                        <div class="role">مدیر ارشد</div>
                    </div>
                    <i class="fas fa-chevron-down" style="color: rgba(255,255,255,0.3); font-size: 12px;"></i>
                </div>
            </div>
        </header>

        <!-- Welcome Section -->
        <div class="welcome-section">
            <h1>خوش آمدید، <span>مدیر سیستم</span></h1>
            <p>از پنل مدیریت برای مدیریت بخش‌های مختلف استفاده کنید</p>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div class="stat-number">۲,۴۵۶</div>
                <div class="stat-label">تعداد کاربران</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-graduation-cap"></i></div>
                <div class="stat-number">۱۲۸</div>
                <div class="stat-label">دانشجویان جدید</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-file-pdf"></i></div>
                <div class="stat-number">۴۲</div>
                <div class="stat-label">مدارک صادر شده</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-clock"></i></div>
                <div class="stat-number">۹۵%</div>
                <div class="stat-label">وضعیت سیستم</div>
            </div>
        </div>

        <!-- Feature Cards -->
        <div class="cards-grid">

            <!-- Card 1: تعریف اطلاعات پایه -->
            <div class="feature-card" onclick="location.href='/BaseInfo/Index'">
                <div class="card-icon">
                    <i class="fas fa-database"></i>
                </div>
                <div class="card-content">
                    <h3>تعریف اطلاعات پایه</h3>
                    <p>
                        مدیریت اطلاعات پایه شامل تعریف رشته‌های تحصیلی، مقاطع تحصیلی،
                        دوره‌ها، استادان و واحدهای درسی.
                    </p>
                </div>
                <div class="card-footer">
                    <a href="#" class="card-link">
                        مشاهده و مدیریت
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <span class="card-status">
                        <i class="fas fa-circle" style="font-size: 8px; margin-left: 5px;"></i>
                        فعال
                    </span>
                </div>
            </div>

            <!-- Card 2: صدور مدرک -->
            <div class="feature-card" onclick="location.href='/Certificates/Search'">
                <div class="card-icon">
                    <i class="fas fa-certificate"></i>
                </div>
                <div class="card-content">
                    <h3>صدور مدرک</h3>
                    <p>
                        صدور انواع مدارک تحصیلی، گواهی‌های دانشجویی،
                        ریز نمرات و مدارک فارغ‌التحصیلی با امضای دیجیتال.
                    </p>
                </div>
                <div class="card-footer">
                    <a href="/Certificates/Search" class="card-link">
                        مشاهده و مدیریت
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <span class="card-status">
                        <i class="fas fa-circle" style="font-size: 8px; margin-left: 5px;"></i>
                        فعال
                    </span>
                </div>
            </div>

            <!-- Card 3: سیستم دانشجویی -->
            <div class="feature-card" onclick="location.href='/Student/Index'">
                <div class="card-icon">
                    <i class="fas fa-user-graduate"></i>
                </div>
                <div class="card-content">
                    <h3>سیستم دانشجویی</h3>
                    <p>
                        مدیریت جامع دانشجویان شامل ثبت‌نام، انتخاب واحد،
                        کارنامه تحصیلی، شهریه و خدمات دانشجویی.
                    </p>
                </div>
                <div class="card-footer">
                    <a href="#" class="card-link">
                        مشاهده و مدیریت
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <span class="card-status">
                        <i class="fas fa-circle" style="font-size: 8px; margin-left: 5px;"></i>
                        فعال
                    </span>
                </div>
            </div>

        </div>
    </div>

    <!-- Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // Set current date
            const now = new Date();
            const options = { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' };
            document.getElementById('currentDate').textContent = now.toLocaleDateString('fa-IR', options);

            // Particles
            const canvas = document.getElementById('particles-canvas');
            const ctx = canvas.getContext('2d');
            let particles = [];

            function resizeCanvas() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);

            class Particle {
                constructor() {
                    this.x = Math.random() * canvas.width;
                    this.y = Math.random() * canvas.height;
                    this.size = Math.random() * 2 + 0.5;
                    this.speedX = (Math.random() - 0.5) * 0.3;
                    this.speedY = (Math.random() - 0.5) * 0.3;
                    this.opacity = Math.random() * 0.3 + 0.1;
                }
                update() {
                    this.x += this.speedX;
                    this.y += this.speedY;
                    if (this.x > canvas.width) this.x = 0;
                    if (this.x < 0) this.x = canvas.width;
                    if (this.y > canvas.height) this.y = 0;
                    if (this.y < 0) this.y = canvas.height;
                }
                draw() {
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(255, 215, 0, ${this.opacity})`;
                    ctx.fill();
                }
            }

            const particleCount = Math.min(80, (canvas.width * canvas.height) / 20000);
            for (let i = 0; i < particleCount; i++) {
                particles.push(new Particle());
            }

            function connectParticles() {
                for (let i = 0; i < particles.length; i++) {
                    for (let j = i + 1; j < particles.length; j++) {
                        const dx = particles[i].x - particles[j].x;
                        const dy = particles[i].y - particles[j].y;
                        const distance = Math.sqrt(dx * dx + dy * dy);
                        if (distance < 150) {
                            ctx.beginPath();
                            ctx.strokeStyle = `rgba(255, 215, 0, ${0.05 * (1 - distance / 150)})`;
                            ctx.lineWidth = 0.5;
                            ctx.moveTo(particles[i].x, particles[i].y);
                            ctx.lineTo(particles[j].x, particles[j].y);
                            ctx.stroke();
                        }
                    }
                }
            }

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                particles.forEach(p => { p.update(); p.draw(); });
                connectParticles();
                requestAnimationFrame(animate);
            }
            animate();
        });
    </script>

</body>
</html>