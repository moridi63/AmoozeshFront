@{
    ViewData["Title"] = "پنل اصلی";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سامانه آموزش</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Bootstrap RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Vazirmatn', sans-serif;
            min-height: 100vh;
            background: #0d0d0d;
            position: relative;
            overflow-x: hidden;
        }

        /* پس‌زمینه شطرنجی ظریف (حس اداری) */
        .bg-grid {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: linear-gradient(rgba(255, 215, 0, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 215, 0, 0.03) 1px, transparent 1px);
            background-size: 60px 60px;
            z-index: 0;
        }

        /* ذرات بسیار کم‌رنگ (حالت اداری) */
        #particles-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            opacity: 0.4;
        }

        /* کانتینر اصلی */
        .main-container {
            position: relative;
            z-index: 1;
            padding: 30px 30px 20px;
            min-height: 100vh;
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ========== هدر ========== */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 28px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            border-radius: 20px;
            border: 1px solid rgba(255, 215, 0, 0.08);
            margin-bottom: 40px;
            transition: all 0.3s ease;
        }

            .header:hover {
                border-color: rgba(255, 215, 0, 0.15);
                box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
            }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-logo {
            width: 46px;
            height: 46px;
            background: linear-gradient(145deg, #ffd700, #e6a800);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 24px rgba(255, 215, 0, 0.15);
        }

            .header-logo i {
                font-size: 24px;
                color: #0d0d0d;
            }

        .header-title h2 {
            color: #fff;
            font-weight: 700;
            margin: 0;
            font-size: 20px;
            letter-spacing: -0.5px;
        }

        .header-title p {
            color: rgba(255, 255, 255, 0.3);
            font-size: 12px;
            margin: 0;
            font-weight: 300;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .header-date {
            color: rgba(255, 255, 255, 0.5);
            font-size: 13px;
            padding: 6px 16px;
            background: rgba(255, 255, 255, 0.04);
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            font-weight: 300;
        }

            .header-date i {
                margin-left: 8px;
                color: rgba(255, 215, 0, 0.5);
            }

        .header-user {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 6px 16px 6px 10px;
            background: rgba(255, 215, 0, 0.04);
            border-radius: 40px;
            border: 1px solid rgba(255, 215, 0, 0.06);
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .header-user:hover {
                background: rgba(255, 215, 0, 0.08);
                border-color: rgba(255, 215, 0, 0.15);
            }

            .header-user .avatar {
                width: 34px;
                height: 34px;
                background: linear-gradient(135deg, #ffd700, #f0a500);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                color: #0d0d0d;
                font-size: 14px;
            }

            .header-user .user-info .name {
                color: #fff;
                font-weight: 600;
                font-size: 13px;
                line-height: 1.3;
            }

            .header-user .user-info .role {
                font-size: 11px;
                color: rgba(255, 255, 255, 0.3);
                font-weight: 300;
            }

            .header-user .chevron {
                color: rgba(255, 255, 255, 0.15);
                font-size: 11px;
                margin-right: 4px;
            }

        /* ========== بخش خوش‌آمدگویی ========== */
        .welcome-section {
            margin-bottom: 40px;
            animation: fadeUp 0.8s ease-out both;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .welcome-section h1 {
            color: #fff;
            font-weight: 800;
            font-size: 28px;
            margin-bottom: 4px;
        }

            .welcome-section h1 span {
                background: linear-gradient(90deg, #ffd700, #ff8c00);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .welcome-section p {
            color: rgba(255, 255, 255, 0.3);
            font-size: 15px;
            font-weight: 300;
        }

        /* ========== کارت‌های اصلی ========== */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 28px;
            animation: fadeUp 0.8s ease-out 0.15s both;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(12px);
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            cursor: pointer;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 280px;
        }

            /* نوار رنگی بالای هر کارت */
            .feature-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                border-radius: 24px 24px 0 0;
                transition: height 0.3s ease;
            }

            .feature-card:hover::before {
                height: 5px;
            }

            /* کارت ۱ - اطلاعات پایه (طلایی) */
            .feature-card:nth-child(1) {
                border-color: rgba(255, 215, 0, 0.06);
            }

                .feature-card:nth-child(1)::before {
                    background: linear-gradient(90deg, #ffd700, #f0a500);
                }

                .feature-card:nth-child(1) .card-icon {
                    background: linear-gradient(145deg, #ffd700, #e6a800);
                    color: #0d0d0d;
                    box-shadow: 0 10px 30px rgba(255, 215, 0, 0.15);
                }

            /* کارت ۲ - صدور مدرک (نارنجی) */
            .feature-card:nth-child(2) {
                border-color: rgba(255, 140, 0, 0.06);
            }

                .feature-card:nth-child(2)::before {
                    background: linear-gradient(90deg, #ff8c00, #e67600);
                }

                .feature-card:nth-child(2) .card-icon {
                    background: linear-gradient(145deg, #ff8c00, #e67600);
                    color: #fff;
                    box-shadow: 0 10px 30px rgba(255, 140, 0, 0.15);
                }

            /* کارت ۳ - سیستم دانشجویی (سرمه‌ای) */
            .feature-card:nth-child(3) {
                border-color: rgba(52, 152, 219, 0.06);
            }

                .feature-card:nth-child(3)::before {
                    background: linear-gradient(90deg, #3498db, #2980b9);
                }

                .feature-card:nth-child(3) .card-icon {
                    background: linear-gradient(145deg, #3498db, #2980b9);
                    color: #fff;
                    box-shadow: 0 10px 30px rgba(52, 152, 219, 0.15);
                }

            .feature-card:hover {
                transform: translateY(-6px);
                border-color: rgba(255, 215, 0, 0.12);
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
            }

        .card-body {
            padding: 32px 28px 24px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .card-icon {
            width: 58px;
            height: 58px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            margin-bottom: 20px;
            transition: all 0.4s ease;
        }

        .feature-card:hover .card-icon {
            transform: scale(1.05) rotate(-2deg);
        }

        .card-body h3 {
            color: #fff;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: -0.3px;
        }

        .card-body p {
            color: rgba(255, 255, 255, 0.35);
            font-size: 14px;
            line-height: 1.8;
            margin-bottom: 18px;
            flex: 1;
            font-weight: 300;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            margin-top: 4px;
        }

        .card-link {
            color: rgba(255, 255, 255, 0.35);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .card-link i {
                font-size: 13px;
                transition: transform 0.3s ease;
            }

        .feature-card:hover .card-link {
            color: #ffd700;
        }

            .feature-card:hover .card-link i {
                transform: translateX(-4px);
            }

        .card-status {
            padding: 4px 14px;
            border-radius: 40px;
            font-size: 11px;
            font-weight: 600;
            background: rgba(46, 213, 115, 0.06);
            color: #2ed573;
            border: 1px solid rgba(46, 213, 115, 0.08);
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .card-status .dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #2ed573;
                display: inline-block;
            }

        /* کارت دوم با وضعیت متفاوت */
        .feature-card:nth-child(2) .card-status {
            background: rgba(255, 215, 0, 0.06);
            color: #ffd700;
            border-color: rgba(255, 215, 0, 0.08);
        }

            .feature-card:nth-child(2) .card-status .dot {
                background: #ffd700;
            }

        .feature-card:nth-child(3) .card-status {
            background: rgba(52, 152, 219, 0.06);
            color: #3498db;
            border-color: rgba(52, 152, 219, 0.08);
        }

            .feature-card:nth-child(3) .card-status .dot {
                background: #3498db;
            }

        /* ========== فوتر ========== */
        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.03);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

            .footer p {
                color: rgba(255, 255, 255, 0.15);
                font-size: 12px;
                font-weight: 300;
                margin: 0;
            }

            .footer a {
                color: rgba(255, 255, 255, 0.2);
                text-decoration: none;
                font-size: 12px;
                transition: color 0.3s ease;
                margin-right: 20px;
            }

                .footer a:hover {
                    color: rgba(255, 215, 0, 0.5);
                }

        /* ========== واکنش‌گرایی ========== */
        @@media (max-width: 992px) {
            .cards-grid {
                grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .main-container {
                padding: 16px;
            }

            .header {
                flex-direction: column;
                align-items: stretch;
                gap: 14px;
                padding: 16px 20px;
            }

            .header-right {
                justify-content: center;
            }

            .header-left {
                justify-content: space-between;
                flex-wrap: wrap;
            }

            .header-date {
                font-size: 12px;
                padding: 4px 12px;
            }

            .welcome-section h1 {
                font-size: 22px;
            }

            .cards-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .card-body {
                padding: 24px 20px 18px;
            }

            .footer {
                flex-direction: column;
                text-align: center;
            }
        }

        @@media (max-width: 480px) {
            .header-user .user-info .role {
                display: none;
            }

            .header-user {
                padding: 4px 10px 4px 8px;
            }

            .card-body h3 {
                font-size: 18px;
            }
        }

        /* اسکرول */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #0d0d0d;
        }

        ::-webkit-scrollbar-thumb {
            background: #ffd700;
            border-radius: 10px;
        }
    </style>
</head>
<body>

    <!-- پس‌زمینه‌ها -->
    <div class="bg-grid"></div>
    <canvas id="particles-canvas"></canvas>

    <!-- کانتینر اصلی -->
    <div class="main-container">

        <!-- ====== هدر ====== -->
        <header class="header">
            <div class="header-right">
                <div class="header-logo">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <div class="header-title">
                    <h2>سامانه آموزش</h2>
                    <p>پنل مدیریت مرکز آموزش وزارت صمت</p>
                </div>
            </div>
            <div class="header-left">
                <div class="header-date">
                    <i class="far fa-calendar-alt"></i>
                    <span id="currentDate"></span>
                </div>
                <div class="header-user">
                    <div class="avatar">ا</div>
                    <div class="user-info">
                        <div class="name">مدیر سیستم</div>
                        <div class="role">مدیر ارشد</div>
                    </div>
                    <i class="fas fa-chevron-down chevron"></i>
                </div>
            </div>
        </header>

        <!-- ====== خوش‌آمدگویی ====== -->
        <div class="welcome-section">
            <h1>خوش آمدید، <span>مدیر سیستم</span></h1>
            <p>از پنل مدیریت برای مدیریت بخش‌های مختلف سامانه استفاده کنید</p>
        </div>

        <!-- ====== کارت‌های اصلی ====== -->
        <div class="cards-grid">

            <!-- کارت ۱: تعریف اطلاعات پایه -->
            <div class="feature-card" onclick="location.href='/BaseInfo/Index'">
                <div class="card-body">
                    <div class="card-icon">
                        <i class="fas fa-database"></i>
                    </div>
                    <h3>تعریف اطلاعات پایه</h3>
                    <p>
                        مدیریت اطلاعات پایه شامل تعریف رشته‌های تحصیلی، مقاطع،
                        دوره‌ها، استادان و واحدهای درسی.
                    </p>
                    <div class="card-footer">
                        <a href="#" class="card-link">
                            مشاهده و مدیریت
                            <i class="fas fa-arrow-left"></i>
                        </a>
                        <span class="card-status">
                            <span class="dot"></span> فعال
                        </span>
                    </div>
                </div>
            </div>

            <!-- کارت ۲: صدور مدرک -->
            <div class="feature-card" onclick="location.href='/Certificates/Search'">
                <div class="card-body">
                    <div class="card-icon">
                        <i class="fas fa-certificate"></i>
                    </div>
                    <h3>صدور مدرک</h3>
                    <p>
                        صدور انواع مدارک تحصیلی، گواهی‌های دانشجویی،
                        ریز نمرات و مدارک فارغ‌التحصیلی با امضای دیجیتال.
                    </p>
                    <div class="card-footer">
                        <a href="/Certificates/Search" class="card-link">
                            مشاهده و مدیریت
                            <i class="fas fa-arrow-left"></i>
                        </a>
                        <span class="card-status">
                            <span class="dot"></span> فعال
                        </span>
                    </div>
                </div>
            </div>

            <!-- کارت ۳: سیستم دانشجویی -->
            <div class="feature-card" onclick="location.href='/Student/Index'">
                <div class="card-body">
                    <div class="card-icon">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <h3>سیستم دانشجویی</h3>
                    <p>
                        مدیریت جامع دانشجویان شامل ثبت‌نام، انتخاب واحد،
                        کارنامه تحصیلی، شهریه و خدمات دانشجویی.
                    </p>
                    <div class="card-footer">
                        <a href="#" class="card-link">
                            مشاهده و مدیریت
                            <i class="fas fa-arrow-left"></i>
                        </a>
                        <span class="card-status">
                            <span class="dot"></span> فعال
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <!-- ====== فوتر ====== -->
        <div class="footer">
            <p>
                <i class="far fa-copyright"></i> ۱۴۰۴ - مرکز آموزش وزارت صنعت، معدن و تجارت
            </p>
            <div>
                <a href="#"><i class="fas fa-headset"></i> پشتیبانی</a>
                <a href="#"><i class="fas fa-info-circle"></i> درباره سامانه</a>
            </div>
        </div>

    </div>

    <!-- ====== اسکریپت‌ها ====== -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // ========== تاریخ شمسی ==========
            const now = new Date();
            const options = { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' };
            document.getElementById('currentDate').textContent = now.toLocaleDateString('fa-IR', options);

            // ========== ذرات (ظریف و اداری) ==========
            const canvas = document.getElementById('particles-canvas');
            const ctx = canvas.getContext('2d');
            let particles = [];

            function resizeCanvas() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);

            class Particle {
                constructor() {
                    this.x = Math.random() * canvas.width;
                    this.y = Math.random() * canvas.height;
                    this.size = Math.random() * 1.8 + 0.3;
                    this.speedX = (Math.random() - 0.5) * 0.2;
                    this.speedY = (Math.random() - 0.5) * 0.2;
                    this.opacity = Math.random() * 0.15 + 0.05;
                }
                update() {
                    this.x += this.speedX;
                    this.y += this.speedY;
                    if (this.x > canvas.width) this.x = 0;
                    if (this.x < 0) this.x = canvas.width;
                    if (this.y > canvas.height) this.y = 0;
                    if (this.y < 0) this.y = canvas.height;
                }
                draw() {
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(255, 215, 0, ${this.opacity})`;
                    ctx.fill();
                }
            }

            const count = Math.min(60, Math.floor((canvas.width * canvas.height) / 25000));
            for (let i = 0; i < count; i++) {
                particles.push(new Particle());
            }

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                particles.forEach(p => { p.update(); p.draw(); });
                requestAnimationFrame(animate);
            }
            animate();
        });
    </script>

</body>
</html>