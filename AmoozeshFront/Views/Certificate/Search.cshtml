@model AmoozeshFront.Models.Certificate.CertificateSearchViewModel

@{
    ViewData["Title"] = "استعلام گواهینامه‌های آموزشی";
    Layout = null;

    var certificatesForPrint = new List<object>();
    if (Model?.Results != null)
    {
        foreach (var c in Model.Results)
        {
            certificatesForPrint.Add(new
            {
                id = c.Id,
                fullName = c.FullName,
                fatherName = c.FatherName,
                nationalCode = Model!.NationalCode,
                companyName = c.CompanyName,
                examTitle = c.ExamTitle,
                examDate = c.ExamDate.HasValue ? c.ExamDate.Value.ToString("yyyy/MM/dd") : "",
                certNumber = c.CertificateNumber,
                qrCodeBase64 = c.QRCodeBase64
            });
        }
    }
    var certificatesJson = System.Text.Json.JsonSerializer.Serialize(certificatesForPrint);
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.07);
            --glass-border: rgba(255, 255, 255, 0.1);
            --gold-glow: 0 0 20px rgba(255, 215, 0, 0.2);
            --accent-gold: #ffd700;
            --text-light: #f3f4f6;
            --cert-box-border: none;
            --cert-font-default: 'B Nazanin', Tahoma, Arial, sans-serif;
            --number-box-top: 15mm;
            --number-box-left: 12mm;
            --number-box-width: 45mm;
            --number-box-height: 10mm;
            --number-box-font-family: var(--cert-font-default);
            --number-box-font-size: 12pt;
            --date-box-top: 27mm;
            --date-box-left: 12mm;
            --date-box-width: 45mm;
            --date-box-height: 10mm;
            --date-box-font-family: var(--cert-font-default);
            --date-box-font-size: 12pt;
            --logo-box-top: 8mm;
            --logo-box-left: 128mm;
            --logo-box-width: 40mm;
            --logo-box-height: 16mm;
            --logo-box-font-family: var(--cert-font-default);
            --logo-box-font-size: 12pt;
            --title-box-top: 26mm;
            --title-box-left: 108mm;
            --title-box-width: 80mm;
            --title-box-height: 16mm;
            --title-box-font-family: var(--cert-font-default);
            --title-box-font-size: 14pt;
            --barcode-box-top: 15mm;
            --barcode-box-left: 235mm;
            --barcode-box-width: 45mm;
            --barcode-box-height: 18mm;
            --barcode-box-font-family: var(--cert-font-default);
            --barcode-box-font-size: 10pt;
            --maintext-box-top: 62mm;
            --maintext-box-left: 35mm;
            --maintext-box-width: 227mm;
            --maintext-box-height: 40mm;
            --maintext-box-font-family: var(--cert-font-default);
            --maintext-box-font-size: 15pt;
            --ceo1-box-top: 110mm;
            --ceo1-box-left: 35mm;
            --ceo1-box-width: 55mm;
            --ceo1-box-height: 28mm;
            --ceo1-box-font-family: var(--cert-font-default);
            --ceo1-box-font-size: 13pt;
            --ceo2-box-top: 110mm;
            --ceo2-box-left: 207mm;
            --ceo2-box-width: 55mm;
            --ceo2-box-height: 28mm;
            --ceo2-box-font-family: var(--cert-font-default);
            --ceo2-box-font-size: 13pt;
        }

        body {
            background: radial-gradient(circle at center, #1a2536 0%, #0d131a 100%);
            color: var(--text-light);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
            position: relative;
            margin: 0;
        }

        .page-container {
            position: relative;
            min-height: 85vh;
            padding: 2rem 0;
            z-index: 2;
        }

        #particles-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
        }

        .search-card {
            background: var(--glass-bg);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3), var(--gold-glow);
            transform: translateY(0);
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            position: relative;
        }

            .search-card:hover {
                transform: translateY(-5px);
                border-color: rgba(255, 215, 0, 0.3);
                box-shadow: 0 30px 50px rgba(0,0,0,0.4), 0 0 30px rgba(255, 215, 0, 0.3);
            }

        .gradient-text {
            background: linear-gradient(135deg, #fff 30%, var(--accent-gold) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 2px 10px rgba(255,255,255,0.05);
        }

        .form-control-custom {
            background: rgba(0, 0, 0, 0.25) !important;
            border: 2px solid rgba(255, 255, 255, 0.1) !important;
            color: #fff !important;
            border-radius: 14px;
            padding: 12px 20px;
            font-size: 1.1rem;
            letter-spacing: 2px;
            transition: all 0.3s ease;
        }

            .form-control-custom:focus {
                border-color: var(--accent-gold) !important;
                box-shadow: 0 0 15px rgba(255, 215, 0, 0.2) !important;
                background: rgba(0, 0, 0, 0.4) !important;
            }

        .btn-gold {
            background: linear-gradient(135deg, #ffd700 0%, #b8860b 100%);
            border: none;
            color: #000;
            font-weight: 700;
            border-radius: 14px;
            padding: 12px 30px;
            font-size: 1.05rem;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(255, 215, 0, 0.3);
        }

            .btn-gold:hover {
                transform: scale(1.03);
                box-shadow: 0 8px 25px rgba(255, 215, 0, 0.5);
                color: #000;
            }

        .certificate-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 18px;
            transition: all 0.3s ease;
        }

            .certificate-card:hover {
                background: rgba(255, 255, 255, 0.08);
                border-color: rgba(255, 215, 0, 0.2);
                transform: translateY(-3px);
            }

        .badge-gold {
            background: rgba(255, 215, 0, 0.15);
            color: var(--accent-gold);
            border: 1px solid rgba(255, 215, 0, 0.3);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
        }

        .text-muted-custom {
            color: #8b949e;
            font-size: 0.9rem;
        }

        .info-value {
            color: #f0f6fc;
            font-weight: 500;
        }

        .btn-print-cert {
            background: transparent;
            border: 1px solid rgba(255, 215, 0, 0.4);
            color: var(--accent-gold);
            border-radius: 10px;
            padding: 5px 12px;
            font-size: 0.85rem;
            transition: all 0.25s ease;
            white-space: nowrap;
        }

            .btn-print-cert:hover {
                background: rgba(255, 215, 0, 0.15);
                color: var(--accent-gold);
                border-color: var(--accent-gold);
            }

        /* ===== استایل‌های QR Code ===== */
        .qr-code-small {
            width: 65px;
            height: 65px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 10px;
            padding: 4px;
            background: white;
            object-fit: contain;
        }

            .qr-code-small:hover {
                transform: scale(1.15);
                border-color: var(--accent-gold);
                box-shadow: 0 0 25px rgba(255, 215, 0, 0.4);
            }

        .qr-code-container {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .qr-code-label {
            font-size: 0.7rem;
            color: #8b949e;
            background: rgba(255, 215, 0, 0.1);
            padding: 2px 8px;
            border-radius: 12px;
            border: 1px solid rgba(255, 215, 0, 0.2);
        }

        .modal-content-dark {
            background: #1a2536 !important;
            border: 1px solid rgba(255, 215, 0, 0.3) !important;
            border-radius: 20px !important;
        }

        .qr-modal-image-container {
            background: white;
            padding: 15px;
            border-radius: 16px;
            display: inline-block;
            box-shadow: 0 0 30px rgba(255, 215, 0, 0.1);
        }

        /* ===== استایل‌های امضا ===== */
        .signature-preview {
            max-width: 100px;
            max-height: 40px;
            object-fit: contain;
            border: 1px dashed #dee2e6;
            border-radius: 6px;
            padding: 4px;
            background: white;
        }

        .signature-thumb {
            width: 80px;
            height: 30px;
            object-fit: contain;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: white;
            padding: 2px;
        }

        .signature-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

            .signature-container .btn-sm {
                font-size: 0.7rem;
                padding: 2px 8px;
            }

        /* ===== تنظیمات چاپ ===== */
        #printCertificateTemplate {
            display: none;
        }

        @@page {
            size: A4 landscape;
            margin: 0;
        }

        body.is-printing-cert {
            background: none !important;
            margin: 0 !important;
            padding: 0 !important;
            min-height: auto !important;
        }

            body.is-printing-cert > *:not(#printCertificateTemplate) {
                display: none !important;
            }

            body.is-printing-cert #printCertificateTemplate {
                display: block !important;
            }

        .cert-page {
            width: 297mm;
            height: 210mm;
            max-height: 210mm;
            box-sizing: border-box;
            padding: 0;
            direction: rtl;
            color: #000;
            font-family: var(--cert-font-default);
            overflow: hidden;
            position: relative;
            page-break-inside: avoid;
            page-break-after: avoid;
            background: #fff;
        }

        .cert-box {
            position: absolute;
            box-sizing: border-box;
            border: var(--cert-box-border);
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            overflow: hidden;
            padding: 2mm;
            direction: rtl;
            font-weight: bold;
        }

        .cert-box-number {
            top: var(--number-box-top);
            left: var(--number-box-left);
            width: var(--number-box-width);
            height: var(--number-box-height);
            font-family: var(--number-box-font-family);
            font-size: var(--number-box-font-size);
        }

        .cert-box-date {
            top: var(--date-box-top);
            left: var(--date-box-left);
            width: var(--date-box-width);
            height: var(--date-box-height);
            font-family: var(--date-box-font-family);
            font-size: var(--date-box-font-size);
        }

        .cert-box-logo {
            top: var(--logo-box-top);
            left: var(--logo-box-left);
            width: var(--logo-box-width);
            height: var(--logo-box-height);
            font-family: var(--logo-box-font-family);
            font-size: var(--logo-box-font-size);
        }

            .cert-box-logo img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .cert-box-title {
            top: var(--title-box-top);
            left: var(--title-box-left);
            width: var(--title-box-width);
            height: var(--title-box-height);
            font-family: var(--title-box-font-family);
            font-size: var(--title-box-font-size);
        }

        .cert-box-barcode {
            top: var(--barcode-box-top);
            left: var(--barcode-box-left);
            width: var(--barcode-box-width);
            height: var(--barcode-box-height);
            font-family: var(--barcode-box-font-family);
            font-size: var(--barcode-box-font-size);
        }

            .cert-box-barcode img,
            .cert-box-barcode svg {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .cert-box-maintext {
            top: var(--maintext-box-top);
            left: var(--maintext-box-left);
            width: var(--maintext-box-width);
            height: var(--maintext-box-height);
            font-family: var(--maintext-box-font-family);
            font-size: var(--maintext-box-font-size);
            font-weight: normal;
            line-height: 2.0;
            text-align: justify;
        }

        .cert-fill {
            font-weight: 700;
            padding: 0 4px;
            display: inline-block;
            min-width: 90px;
            text-align: center;
        }

        .cert-box-ceo1 {
            top: var(--ceo1-box-top);
            left: var(--ceo1-box-left);
            width: var(--ceo1-box-width);
            height: var(--ceo1-box-height);
            font-family: var(--ceo1-box-font-family);
            font-size: var(--ceo1-box-font-size);
            flex-direction: column;
            gap: 1mm;
        }

        .cert-box-ceo2 {
            top: var(--ceo2-box-top);
            left: var(--ceo2-box-left);
            width: var(--ceo2-box-width);
            height: var(--ceo2-box-height);
            font-family: var(--ceo2-box-font-family);
            font-size: var(--ceo2-box-font-size);
            flex-direction: column;
            gap: 1mm;
        }

        .cert-sig-title {
            font-size: 0.7em;
            font-weight: normal;
            color: #333;
        }

        .cert-signature-img {
            max-width: 60mm;
            max-height: 12mm;
            object-fit: contain;
        }

        /* ===== تنظیمات قالب چاپ ===== */
        .btn-settings-cert {
            background: rgba(255, 215, 0, 0.1);
            border: 1px solid rgba(255, 215, 0, 0.4);
            color: var(--accent-gold);
            border-radius: 12px;
            padding: 8px 18px;
            font-size: 0.9rem;
            transition: all 0.25s ease;
        }

            .btn-settings-cert:hover {
                background: rgba(255, 215, 0, 0.2);
                color: var(--accent-gold);
                border-color: var(--accent-gold);
            }

        .cert-box-field-group {
            background: #f8f9fa;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 12px 14px;
            margin-bottom: 12px;
        }

            .cert-box-field-group h6 {
                font-weight: 700;
                margin-bottom: 10px;
                color: #333;
            }

            .cert-box-field-group label {
                font-size: 0.78rem;
                color: #555;
                margin-bottom: 2px;
            }

            .cert-box-field-group .form-control,
            .cert-box-field-group .form-select {
                font-size: 0.85rem;
                padding: 4px 8px;
            }

        .cert-preview-stage {
            width: calc(297mm * 0.42);
            height: calc(210mm * 0.42);
            overflow: hidden;
            border: 2px dashed #999;
            margin: 0 auto;
            background: #f1f2f4;
            position: sticky;
            top: 10px;
        }

        .cert-page-preview {
            transform: scale(0.42);
            transform-origin: top left;
        }

        @@media (max-width: 991px) {
            .cert-preview-stage {
                position: static;
                width: 100%;
                height: calc(100vw * 0.42 * (210 / 297));
            }
        }

        @@media print {
            .cert-page {
                box-shadow: none;
            }
        }
    </style>
</head>
<body>

    <canvas id="particles-canvas"></canvas>

    <div class="container page-container" dir="rtl">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 text-center">
                <h2 class="fw-bold mb-3 gradient-text">سامانه هوشمند استعلام گواهینامه‌ها</h2>
                <p class="text-muted-custom fs-6">جهت مشاهده گواهینامه‌های آموزشی خود، کد ملی ده رقمی را وارد نمایید.</p>
                <button type="button" class="btn btn-settings-cert mt-2" data-bs-toggle="modal" data-bs-target="#certSettingsModal">
                    <i class="bi bi-gear"></i> تنظیمات قالب چاپ گواهینامه
                </button>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card search-card p-4 p-md-5 mb-5">
                    <form asp-action="Search" method="post" id="searchForm">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 text-white mb-4" style="background: rgba(220, 53, 69, 0.2); border-right: 4px solid #dc3545 !important; border-radius: 12px;">
                                <div asp-validation-summary="All" class="text-danger small"></div>
                            </div>
                        }

                        <div class="mb-4">
                            <label asp-for="NationalCode" class="form-label text-light fw-semibold mb-2">کد ملی</label>
                            <div class="position-relative">
                                <input asp-for="NationalCode"
                                       class="form-control form-control-custom text-center"
                                       placeholder="مثال: 1234567890"
                                       maxlength="10"
                                       autocomplete="off" />
                            </div>
                            <span asp-validation-for="NationalCode" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-gold w-100 d-flex align-items-center justify-content-center gap-2 py-3">
                            <span>بررسی و استعلام</span>
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @if (Model != null && Model.HasSearched)
        {
            <div class="row justify-content-center mt-4">
                <div class="col-md-10">
                    @if (Model.Results != null && Model.Results.Any())
                    {
                        <h4 class="mb-4 text-light fw-bold d-flex align-items-center gap-2">
                            <span class="badge badge-gold">@Model.Results.Count</span>
                            <span>گواهینامه‌های یافت شده</span>
                        </h4>

                        <div class="row g-4">
                            @{
                                var certIndex = 0;
                            }
                            @foreach (var cert in Model.Results)
                            {
                                <div class="col-md-6">
                                    <div class="card certificate-card h-100 p-4">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="text-white fw-bold mb-0">
                                                <i class="bi bi-award text-warning me-1"></i> @cert.ExamTitle
                                            </h5>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge badge-gold">شماره: @cert.CertificateNumber</span>
                                                <button type="button"
                                                        class="btn btn-print-cert"
                                                        onclick="printCertificate(@certIndex)"
                                                        title="پرینت گواهینامه">
                                                    <i class="bi bi-printer"></i> پرینت
                                                </button>
                                            </div>
                                        </div>

                                        <hr class="border-secondary opacity-25 my-3">

                                        <div class="row g-3">
                                            <div class="col-sm-6">
                                                <div class="mb-2">
                                                    <span class="text-muted-custom">نام و نام خانوادگی:</span>
                                                    <span class="info-value ms-1">@cert.FullName</span>
                                                </div>
                                                <div class="mb-2">
                                                    <span class="text-muted-custom">نام پدر:</span>
                                                    <span class="info-value ms-1">@cert.FatherName</span>
                                                </div>
                                                <div class="mb-2">
                                                    <span class="text-muted-custom">کد ملی:</span>
                                                    <span class="info-value ms-1">@Model.NationalCode</span>
                                                </div>
                                            </div>

                                            <div class="col-sm-6">
                                                <div class="mb-2">
                                                    <span class="text-muted-custom">نام شرکت / ارگان:</span>
                                                    <span class="info-value ms-1">@cert.CompanyName</span>
                                                </div>
                                                <div class="mb-2">
                                                    <span class="text-muted-custom">تاریخ آزمون:</span>
                                                    <span class="info-value ms-1">
                                                        @(cert.ExamDate.HasValue? cert.ExamDate.Value.ToString("yyyy/MM/dd") : "ثبت نشده")
                                                    </span>
                                                </div>
                                                <div class="mb-2">
                                                    <div class="qr-code-container">
                                                        <span class="text-muted-custom">بارکد دوبعدی:</span>
                                                        @if (!string.IsNullOrEmpty(cert.QRCodeBase64))
                                                        {
                                                            <img src="data:image/png;base64,@cert.QRCodeBase64"
                                                                 class="qr-code-small"
                                                                 onclick="showQRCodeModal('@cert.QRCodeBase64', '@cert.FullName', '@cert.CertificateNumber')"
                                                                 title="برای بزرگنمایی کلیک کنید"
                                                                 alt="QR Code" />
                                                            <span class="qr-code-label">
                                                                <i class="bi bi-info-circle"></i> کلیک کنید
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted-custom">بارکد موجود نیست</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mt-3 pt-2 border-top border-secondary border-opacity-25 align-items-center">
                                            <div class="col-6">
                                                <span class="text-muted-custom">مدت دوره:</span>
                                                <span class="badge bg-secondary ms-1">@(cert.DurationHours.HasValue ? $"{cert.DurationHours} ساعت" : "نامشخص")</span>
                                            </div>
                                            <div class="col-6 text-end">
                                                <span class="badge bg-opacity-10 bg-success text-success border border-success px-3 py-1">
                                                    @cert.StatusDisplay
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                certIndex++;
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-5 rounded-4 border border-secondary border-opacity-25" style="background: rgba(255,255,255,0.02);">
                            <i class="bi bi-exclamation-triangle text-warning display-4 mb-3 d-block"></i>
                            <h5 class="text-white fw-bold">هیچ گواهینامه‌ای یافت نشد</h5>
                            <p class="text-muted-custom small mb-0">برای کد ملی وارد شده، اطلاعاتی در سامانه آموزش ثبت نشده است.</p>
                        </div>
