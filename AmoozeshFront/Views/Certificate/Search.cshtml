    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        window.certificatesData = @Html.Raw(certificatesJson);

        function printCertificate(index) {
            var data = window.certificatesData[index];
            if (!data) return;

            document.getElementById('pFullName').textContent = data.fullName || '';
            document.getElementById('pFatherName').textContent = data.fatherName || '';
            document.getElementById('pNationalCode').textContent = data.nationalCode || '';
            document.getElementById('pCompanyName').textContent = data.companyName || '';
            document.getElementById('pExamTitle').textContent = data.examTitle || '';
            document.getElementById('pExamDate').textContent = data.examDate || '';
            document.getElementById('pCertNumber').textContent = data.certNumber || '---';

            var options = { year: 'numeric', month: '2-digit', day: '2-digit' };
            var todayPersian = new Date().toLocaleDateString('fa-IR', options);
            document.getElementById('pCurrentDate').textContent = todayPersian;

            // TODO: بارکد - وقتی فرمول تولید بارکد مشخص شد، اینجا خروجی رو
            // داخل کادر #pBarcode قرار بدید، مثلاً:
            // document.getElementById('pBarcode').innerHTML = generateBarcode(data.certNumber);

            document.body.classList.add('is-printing-cert');
            window.print();
        }

        window.addEventListener('afterprint', function () {
            document.body.classList.remove('is-printing-cert');
        });

        /* =====================================================================
           پنل تنظیمات قالب چاپ - قابل تغییر توسط کاربر نهایی از داخل مرورگر
           ===================================================================== */
        (function () {
            var STORAGE_KEY = 'certTemplateSettingsV1';

            var BOX_DEFS = [
                { key: 'number', label: 'شماره' },
                { key: 'date', label: 'تاریخ' },
                { key: 'logo', label: 'لوگو' },
                { key: 'title', label: 'عنوان سر تیتر' },
                { key: 'barcode', label: 'بارکد' },
                { key: 'maintext', label: 'متن اصلی' },
                { key: 'ceo1', label: 'مدیرعامل (چپ)' },
                { key: 'ceo2', label: 'مدیرعامل دوم (راست)' }
            ];

            var FONT_OPTIONS = [
                { value: "'B Nazanin', Tahoma, Arial, sans-serif", label: 'B Nazanin' },
                { value: "'B Titr', Tahoma, Arial, sans-serif", label: 'B Titr' },
                { value: "Tahoma, Arial, sans-serif", label: 'Tahoma' },
                { value: "'IRANSans', Tahoma, Arial, sans-serif", label: 'IRANSans' },
                { value: "Arial, sans-serif", label: 'Arial' }
            ];

            var DEFAULT_SETTINGS = {
                number:   { top: 15, left: 12,  width: 45,  height: 10, font: FONT_OPTIONS[0].value, size: 12 },
                date:     { top: 27, left: 12,  width: 45,  height: 10, font: FONT_OPTIONS[0].value, size: 12 },
                logo:     { top: 8,  left: 128, width: 40,  height: 16, font: FONT_OPTIONS[0].value, size: 12 },
                title:    { top: 26, left: 108, width: 80,  height: 16, font: FONT_OPTIONS[0].value, size: 14 },
                barcode:  { top: 15, left: 235, width: 45,  height: 18, font: FONT_OPTIONS[0].value, size: 10 },
                maintext: { top: 62, left: 35,  width: 227, height: 40, font: FONT_OPTIONS[0].value, size: 15 },
                ceo1:     { top: 120, left: 35, width: 55,  height: 22, font: FONT_OPTIONS[0].value, size: 13 },
                ceo2:     { top: 120, left: 207, width: 55, height: 22, font: FONT_OPTIONS[0].value, size: 13 },
                texts: {
                    certTitle: 'عنوان سر تیتر',
                    ceo1Name: 'محمدرضا زهره‌وندی',
                    ceo1Title: 'رئیس هیأت‌مدیره سندیکای صنایع آسانسور',
                    ceo2Name: 'محمد وحیدی',
                    ceo2Title: 'مدیر عامل مرکز آموزش بازرگانی'
                },
                logoSrc: ''
            };

            function cloneDefaults() {
                return JSON.parse(JSON.stringify(DEFAULT_SETTINGS));
            }

            function loadSettings() {
                var settings = cloneDefaults();
                try {
                    var raw = localStorage.getItem(STORAGE_KEY);
                    if (raw) {
                        var saved = JSON.parse(raw);
                        BOX_DEFS.forEach(function (box) {
                            if (saved[box.key]) {
                                settings[box.key] = Object.assign({}, settings[box.key], saved[box.key]);
                            }
                        });
                        if (saved.texts) {
                            settings.texts = Object.assign({}, settings.texts, saved.texts);
                        }
                        if (typeof saved.logoSrc === 'string') {
                            settings.logoSrc = saved.logoSrc;
                        }
                    }
                } catch (e) {
                    console.error('خطا در خواندن تنظیمات ذخیره‌شده:', e);
                }
                return settings;
            }

            function saveSettings(settings) {
                try {
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
                } catch (e) {
                    console.error('خطا در ذخیره تنظیمات:', e);
                }
            }

            function applySettings(settings) {
                var root = document.documentElement.style;
                BOX_DEFS.forEach(function (box) {
                    var b = settings[box.key];
                    root.setProperty('--' + box.key + '-box-top', b.top + 'mm');
                    root.setProperty('--' + box.key + '-box-left', b.left + 'mm');
                    root.setProperty('--' + box.key + '-box-width', b.width + 'mm');
                    root.setProperty('--' + box.key + '-box-height', b.height + 'mm');
                    root.setProperty('--' + box.key + '-box-font-family', b.font);
                    root.setProperty('--' + box.key + '-box-font-size', b.size + 'pt');
                });

                // متن‌ها - هم در قالب واقعی چاپ و هم در پیش‌نمایش
                setText('pCertTitle', settings.texts.certTitle);
                setText('pCertTitlePreview', settings.texts.certTitle);
                setText('pCeo1Name', settings.texts.ceo1Name);
                setText('pCeo1NamePreview', settings.texts.ceo1Name);
                setText('pCeo1Title', settings.texts.ceo1Title);
                setText('pCeo1TitlePreview', settings.texts.ceo1Title);
                setText('pCeo2Name', settings.texts.ceo2Name);
                setText('pCeo2NamePreview', settings.texts.ceo2Name);
                setText('pCeo2Title', settings.texts.ceo2Title);
                setText('pCeo2TitlePreview', settings.texts.ceo2Title);

                // لوگو
                setLogoSrc('pLogo', settings.logoSrc);
                setLogoSrc('pLogoPreview', settings.logoSrc);
                var thumb = document.getElementById('logoThumb');
                if (thumb) {
                    if (settings.logoSrc) {
                        thumb.src = settings.logoSrc;
                        thumb.style.display = 'inline-block';
                    } else {
                        thumb.style.display = 'none';
                    }
                }
            }

            function setText(id, value) {
                var el = document.getElementById(id);
                if (el) el.textContent = value || '';
            }

            function setLogoSrc(id, src) {
                var el = document.getElementById(id);
                if (el) el.src = src || '';
            }

            function fieldId(boxKey, prop) {
                return 'box-' + boxKey + '-' + prop;
            }

            function buildFontOptionsHtml(selected) {
                return FONT_OPTIONS.map(function (f) {
                    var sel = f.value === selected ? ' selected' : '';
                    return '<option value="' + f.value.replace(/"/g, '&quot;') + '"' + sel + '>' + f.label + '</option>';
                }).join('');
            }

            function buildAccordionForm(settings) {
                var container = document.getElementById('certBoxAccordion');
                if (!container) return;

                var html = BOX_DEFS.map(function (box) {
                    var b = settings[box.key];
                    return '' +
                        '<div class="cert-box-field-group">' +
                        '  <h6><i class="bi bi-bounding-box"></i> ' + box.label + '</h6>' +
                        '  <div class="row g-2">' +
                        '    <div class="col-3"><label>بالا (mm)</label><input type="number" step="1" class="form-control form-control-sm" id="' + fieldId(box.key, 'top') + '" value="' + b.top + '"></div>' +
                        '    <div class="col-3"><label>چپ (mm)</label><input type="number" step="1" class="form-control form-control-sm" id="' + fieldId(box.key, 'left') + '" value="' + b.left + '"></div>' +
                        '    <div class="col-3"><label>عرض (mm)</label><input type="number" step="1" class="form-control form-control-sm" id="' + fieldId(box.key, 'width') + '" value="' + b.width + '"></div>' +
                        '    <div class="col-3"><label>ارتفاع (mm)</label><input type="number" step="1" class="form-control form-control-sm" id="' + fieldId(box.key, 'height') + '" value="' + b.height + '"></div>' +
                        '    <div class="col-8"><label>فونت</label><select class="form-select form-select-sm" id="' + fieldId(box.key, 'font') + '">' + buildFontOptionsHtml(b.font) + '</select></div>' +
                        '    <div class="col-4"><label>سایز فونت (pt)</label><input type="number" step="1" class="form-control form-control-sm" id="' + fieldId(box.key, 'size') + '" value="' + b.size + '"></div>' +
                        '  </div>' +
                        '</div>';
                }).join('');

                container.innerHTML = html;

                BOX_DEFS.forEach(function (box) {
                    ['top', 'left', 'width', 'height', 'size'].forEach(function (prop) {
                        var input = document.getElementById(fieldId(box.key, prop));
                        if (input) {
                            input.addEventListener('input', function () {
                                var num = parseFloat(input.value);
                                if (isNaN(num)) return;
                                currentSettings[box.key][prop] = num;
                                applySettings(currentSettings);
                                saveSettings(currentSettings);
                            });
                        }
                    });
                    var fontSelect = document.getElementById(fieldId(box.key, 'font'));
                    if (fontSelect) {
                        fontSelect.addEventListener('change', function () {
                            currentSettings[box.key].font = fontSelect.value;
                            applySettings(currentSettings);
                            saveSettings(currentSettings);
                        });
                    }
                });
            }

            function populateTextInputs(settings) {
                var map = {
                    'text-certTitle': settings.texts.certTitle,
                    'text-ceo1Name': settings.texts.ceo1Name,
                    'text-ceo1Title': settings.texts.ceo1Title,
                    'text-ceo2Name': settings.texts.ceo2Name,
                    'text-ceo2Title': settings.texts.ceo2Title
                };
                Object.keys(map).forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.value = map[id] || '';
                });
            }

            function bindTextInputs() {
                var pairs = [
                    ['text-certTitle', 'certTitle'],
                    ['text-ceo1Name', 'ceo1Name'],
                    ['text-ceo1Title', 'ceo1Title'],
                    ['text-ceo2Name', 'ceo2Name'],
                    ['text-ceo2Title', 'ceo2Title']
                ];
                pairs.forEach(function (pair) {
                    var el = document.getElementById(pair[0]);
                    if (el) {
                        el.addEventListener('input', function () {
                            currentSettings.texts[pair[1]] = el.value;
                            applySettings(currentSettings);
                            saveSettings(currentSettings);
                        });
                    }
                });
            }

            function bindLogoUpload() {
                var input = document.getElementById('logoUploadInput');
                var removeBtn = document.getElementById('logoRemoveBtn');
                if (input) {
                    input.addEventListener('change', function () {
                        var file = input.files && input.files[0];
                        if (!file) return;
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            currentSettings.logoSrc = e.target.result;
                            applySettings(currentSettings);
                            saveSettings(currentSettings);
                        };
                        reader.readAsDataURL(file);
                    });
                }
                if (removeBtn) {
                    removeBtn.addEventListener('click', function () {
                        currentSettings.logoSrc = '';
                        if (input) input.value = '';
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                    });
                }
            }

            function bindResetButton() {
                var btn = document.getElementById('certSettingsResetBtn');
                if (btn) {
                    btn.addEventListener('click', function () {
                        currentSettings = cloneDefaults();
                        saveSettings(currentSettings);
                        applySettings(currentSettings);
                        buildAccordionForm(currentSettings);
                        populateTextInputs(currentSettings);
                        var logoInput = document.getElementById('logoUploadInput');
                        if (logoInput) logoInput.value = '';
                    });
                }
            }

            var currentSettings = loadSettings();

            document.addEventListener('DOMContentLoaded', function () {
                applySettings(currentSettings);
                buildAccordionForm(currentSettings);
                populateTextInputs(currentSettings);
                bindTextInputs();
                bindLogoUpload();
                bindResetButton();

                var modalEl = document.getElementById('certSettingsModal');
                if (modalEl) {
                    modalEl.addEventListener('shown.bs.modal', function () {
                        buildAccordionForm(currentSettings);
                        populateTextInputs(currentSettings);
                    });
                }
            });
        })();

        $(document).ready(function () {
            $('#NationalCode').on('input', function () {
                let value = this.value;
                const persianNumbers = [/۰/g, /۱/g, /۲/g, /۳/g, /۴/g, /۵/g, /۶/g, /۷/g, /۸/g, /۹/g];
                const arabicNumbers = [/٠/g, /١/g, /٢/g, /٣/g, /٤/g, /٥/g, /٦/g, /٧/g, /٨/g, /٩/g];

                for (let i = 0; i < 10; i++) {
                    value = value.replace(persianNumbers[i], i).replace(arabicNumbers[i], i);
                }

                this.value = value.replace(/[^0-9]/g, '');
            });

            const canvas = document.getElementById('particles-canvas');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                let particles = [];

                function resizeCanvas() {
                    canvas.width = window.innerWidth;
                    canvas.height = Math.max(document.documentElement.scrollHeight, window.innerHeight);
                }

                resizeCanvas();
                $(window).on('resize', function () {
                    resizeCanvas();
                    init();
                });

                class Particle {
                    constructor() {
                        this.x = Math.random() * canvas.width;
                        this.y = Math.random() * canvas.height;
                        this.size = Math.random() * 2 + 0.5;
                        this.speedX = (Math.random() - 0.5) * 0.3;
                        this.speedY = (Math.random() - 0.5) * 0.3;
                        this.opacity = Math.random() * 0.3 + 0.1;
                    }
                    update() {
                        this.x += this.speedX;
                        this.y += this.speedY;
                        if (this.x > canvas.width) this.x = 0;
                        if (this.x < 0) this.x = canvas.width;
                        if (this.y > canvas.height) this.y = 0;
                        if (this.y < 0) this.y = canvas.height;
                    }
                    draw() {
                        ctx.beginPath();
                        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                        ctx.fillStyle = `rgba(255, 215, 0, ${this.opacity})`;
                        ctx.fill();
                    }
                }

                function init() {
                    particles = [];
                    for (let i = 0; i < 60; i++) {
                        particles.push(new Particle());
                    }
                }

                function animate() {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    particles.forEach(p => {
                        p.update();
                        p.draw();
                    });
                    requestAnimationFrame(animate);
                }

                init();
                animate();
            }
        });
    </script>

</body>
</html>
