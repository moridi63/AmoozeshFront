                    var reader = new FileReader();
                    reader.onload = function (e) {
                        currentSettings.ceo2Sig = e.target.result;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview('ceo2');
                    };
                    reader.readAsDataURL(file);
                });
            }
            if (ceo2Remove) {
                ceo2Remove.addEventListener('click', function () {
                    currentSettings.ceo2Sig = '';
                    if (ceo2Input) ceo2Input.value = '';
                    applySettings(currentSettings);
                    saveSettings(currentSettings);
                    refreshBoxPreview('ceo2');
                });
            }

            var ceo1SigWidth = document.getElementById('ceo1-sig-width');
            var ceo1SigHeight = document.getElementById('ceo1-sig-height');
            var ceo1SigTop = document.getElementById('ceo1-sig-top');
            var ceo1SigLeft = document.getElementById('ceo1-sig-left');
            var ceo2SigWidth = document.getElementById('ceo2-sig-width');
            var ceo2SigHeight = document.getElementById('ceo2-sig-height');
            var ceo2SigTop = document.getElementById('ceo2-sig-top');
            var ceo2SigLeft = document.getElementById('ceo2-sig-left');

            if (ceo1SigWidth) {
                ceo1SigWidth.addEventListener('input', function () {
                    var val = parseFloat(ceo1SigWidth.value);
                    if (!isNaN(val) && val > 0) {
                        currentSettings.ceo1SigWidth = val;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview('ceo1');
                    }
                });
            }
            if (ceo1SigHeight) {
                ceo1SigHeight.addEventListener('input', function () {
                    var val = parseFloat(ceo1SigHeight.value);
                    if (!isNaN(val) && val > 0) {
                        currentSettings.ceo1SigHeight = val;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview('ceo1');
                    }
                });
            }
            if (ceo1SigTop) {
                ceo1SigTop.addEventListener('input', function () {
                    var val = parseFloat(ceo1SigTop.value);
                    if (!isNaN(val) && val >= 0 && val <= 100) {
                        currentSettings.ceo1SigTopOffset = val;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview('ceo1');
                    }
                });
            }
            if (ceo1SigLeft) {
                ceo1SigLeft.addEventListener('input', function () {
                    var val = parseFloat(ceo1SigLeft.value);
                    if (!isNaN(val) && val >= 0 && val <= 100) {
                        currentSettings.ceo1SigLeftOffset = val;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview('ceo1');
                    }
                });
            }

            if (ceo2SigWidth) {
                ceo2SigWidth.addEventListener('input', function () {
                    var val = parseFloat(ceo2SigWidth.value);
                    if (!isNaN(val) && val > 0) {
                        currentSettings.ceo2SigWidth = val;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview('ceo2');
                    }
                });
            }
            if (ceo2SigHeight) {
                ceo2SigHeight.addEventListener('input', function () {
                    var val = parseFloat(ceo2SigHeight.value);
                    if (!isNaN(val) && val > 0) {
                        currentSettings.ceo2SigHeight = val;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview('ceo2');
                    }
                });
            }
            if (ceo2SigTop) {
                ceo2SigTop.addEventListener('input', function () {
                    var val = parseFloat(ceo2SigTop.value);
                    if (!isNaN(val) && val >= 0 && val <= 100) {
                        currentSettings.ceo2SigTopOffset = val;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview('ceo2');
                    }
                });
            }
            if (ceo2SigLeft) {
                ceo2SigLeft.addEventListener('input', function () {
                    var val = parseFloat(ceo2SigLeft.value);
                    if (!isNaN(val) && val >= 0 && val <= 100) {
                        currentSettings.ceo2SigLeftOffset = val;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview('ceo2');
                    }
                });
            }
        }

        function saveCurrentSettings() {
            BOX_DEFS.forEach(function (box) {
                if (!currentSettings[box.key]) currentSettings[box.key] = {};
                ['top', 'left', 'width', 'height', 'size'].forEach(function (prop) {
                    var input = document.getElementById(fieldId(box.key, prop));
                    if (input) {
                        var val = parseFloat(input.value);
                        if (!isNaN(val)) {
                            currentSettings[box.key][prop] = val;
                        }
                    }
                });
                var fontSelect = document.getElementById(fieldId(box.key, 'font'));
                if (fontSelect) {
                    currentSettings[box.key].font = fontSelect.value;
                }
            });

            var textPairs = [
                ['text-certTitle', 'certTitle'],
                ['text-ceo1Name', 'ceo1Name'],
                ['text-ceo1Title', 'ceo1Title'],
                ['text-ceo2Name', 'ceo2Name'],
                ['text-ceo2Title', 'ceo2Title'],
                ['text-notice1', 'notice1'],
                ['text-notice2', 'notice2']
            ];
            textPairs.forEach(function (pair) {
                var el = document.getElementById(pair[0]);
                if (el) {
                    currentSettings.texts[pair[1]] = el.value;
                }
            });

            var sigSettings = [
                ['ceo1-sig-width', 'ceo1SigWidth'],
                ['ceo1-sig-height', 'ceo1SigHeight'],
                ['ceo1-sig-top', 'ceo1SigTopOffset'],
                ['ceo1-sig-left', 'ceo1SigLeftOffset'],
                ['ceo2-sig-width', 'ceo2SigWidth'],
                ['ceo2-sig-height', 'ceo2SigHeight'],
                ['ceo2-sig-top', 'ceo2SigTopOffset'],
                ['ceo2-sig-left', 'ceo2SigLeftOffset']
            ];
            sigSettings.forEach(function (pair) {
                var el = document.getElementById(pair[0]);
                if (el) {
                    var val = parseFloat(el.value);
                    if (!isNaN(val)) {
                        currentSettings[pair[1]] = val;
                    }
                }
            });

            saveSettings(currentSettings);
            applySettings(currentSettings);

            var saveBtn = document.getElementById('certSettingsSaveBtn');
            var originalText = saveBtn.innerHTML;
            saveBtn.innerHTML = '<i class="bi bi-check-circle"></i> ذخیره شد!';
            saveBtn.classList.add('btn-success');
            setTimeout(function () {
                saveBtn.innerHTML = originalText;
                saveBtn.classList.remove('btn-success');
            }, 2000);

            buildAccordionForm(currentSettings);
        }

        function bindResetButton() {
            var btn = document.getElementById('certSettingsResetBtn');
            if (btn) {
                btn.addEventListener('click', function () {
                    currentSettings = cloneDefaults();
                    saveSettings(currentSettings);
                    applySettings(currentSettings);
                    buildAccordionForm(currentSettings);
                    populateTextInputs(currentSettings);
                    var logo1Input = document.getElementById('logo1UploadInput');
                    if (logo1Input) logo1Input.value = '';
                    var logo2Input = document.getElementById('logo2UploadInput');
                    if (logo2Input) logo2Input.value = '';
                    var ceo1Input = document.getElementById('ceo1SigUpload');
                    if (ceo1Input) ceo1Input.value = '';
                    var ceo2Input = document.getElementById('ceo2SigUpload');
                    if (ceo2Input) ceo2Input.value = '';
                    var ceo1SigWidth = document.getElementById('ceo1-sig-width');
                    var ceo1SigHeight = document.getElementById('ceo1-sig-height');
                    var ceo1SigTop = document.getElementById('ceo1-sig-top');
                    var ceo1SigLeft = document.getElementById('ceo1-sig-left');
                    var ceo2SigWidth = document.getElementById('ceo2-sig-width');
                    var ceo2SigHeight = document.getElementById('ceo2-sig-height');
                    var ceo2SigTop = document.getElementById('ceo2-sig-top');
                    var ceo2SigLeft = document.getElementById('ceo2-sig-left');
                    if (ceo1SigWidth) ceo1SigWidth.value = 60;
                    if (ceo1SigHeight) ceo1SigHeight.value = 25;
                    if (ceo1SigTop) ceo1SigTop.value = 50;
                    if (ceo1SigLeft) ceo1SigLeft.value = 50;
                    if (ceo2SigWidth) ceo2SigWidth.value = 60;
                    if (ceo2SigHeight) ceo2SigHeight.value = 25;
                    if (ceo2SigTop) ceo2SigTop.value = 50;
                    if (ceo2SigLeft) ceo2SigLeft.value = 50;
                });
            }
        }

        function bindSaveButton() {
            var btn = document.getElementById('certSettingsSaveBtn');
            if (btn) {
                btn.addEventListener('click', saveCurrentSettings);
            }
        }

        var currentSettings = loadSettings();

        document.addEventListener('DOMContentLoaded', function () {
            applySettings(currentSettings);
            buildAccordionForm(currentSettings);
            populateTextInputs(currentSettings);
            bindTextInputs();
            bindLogoUploads();
            bindSignatureUploads();
            bindResetButton();
            bindSaveButton();

            document.querySelectorAll('.cert-bg-toggle').forEach(function (chk) {
                chk.addEventListener('change', function () {
                    currentSettings.useBackground = chk.checked;
                    saveSettings(currentSettings);
                    applySettings(currentSettings);
                });
            });

            var modalEl = document.getElementById('certSettingsModal');
            if (modalEl) {
                modalEl.addEventListener('shown.bs.modal', function () {
                    buildAccordionForm(currentSettings);
                    populateTextInputs(currentSettings);
                    applySettings(currentSettings);
                    document.getElementById('ceo1-sig-width').value = currentSettings.ceo1SigWidth || 60;
                    document.getElementById('ceo1-sig-height').value = currentSettings.ceo1SigHeight || 25;
                    document.getElementById('ceo1-sig-top').value = currentSettings.ceo1SigTopOffset || 50;
                    document.getElementById('ceo1-sig-left').value = currentSettings.ceo1SigLeftOffset || 50;
                    document.getElementById('ceo2-sig-width').value = currentSettings.ceo2SigWidth || 60;
                    document.getElementById('ceo2-sig-height').value = currentSettings.ceo2SigHeight || 25;
                    document.getElementById('ceo2-sig-top').value = currentSettings.ceo2SigTopOffset || 50;
                    document.getElementById('ceo2-sig-left').value = currentSettings.ceo2SigLeftOffset || 50;
                });
            }

            var btnAllDb = document.getElementById('btnPrintAllDb');
            if (btnAllDb) {
                btnAllDb.addEventListener('click', printAllFromDatabase);
            }
        });

        $(document).ready(function () {
            $('#NationalCode').on('input', function () {
                let value = this.value;
                const persianNumbers = [/۰/g, /۱/g, /۲/g, /۳/g, /۴/g, /۵/g, /۶/g, /۷/g, /۸/g, /۹/g];
                const arabicNumbers = [/٠/g, /١/g, /٢/g, /٣/g, /٤/g, /٥/g, /٦/g, /٧/g, /٨/g, /٩/g];

                for (let i = 0; i < 10; i++) {
                    value = value.replace(persianNumbers[i], i).replace(arabicNumbers[i], i);
                }

                this.value = value.replace(/[^0-9]/g, '');
            });

            const canvas = document.getElementById('particles-canvas');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                let particles = [];

                function resizeCanvas() {
                    canvas.width = window.innerWidth;
                    canvas.height = Math.max(document.documentElement.scrollHeight, window.innerHeight);
                }

                resizeCanvas();
                $(window).on('resize', function () {
                    resizeCanvas();
                    init();
                });

                class Particle {
                    constructor() {
                        this.x = Math.random() * canvas.width;
                        this.y = Math.random() * canvas.height;
                        this.size = Math.random() * 2 + 0.5;
                        this.speedX = (Math.random() - 0.5) * 0.3;
                        this.speedY = (Math.random() - 0.5) * 0.3;
                        this.opacity = Math.random() * 0.3 + 0.1;
                    }
                    update() {
                        this.x += this.speedX;
                        this.y += this.speedY;
                        if (this.x > canvas.width) this.x = 0;
                        if (this.x < 0) this.x = canvas.width;
                        if (this.y > canvas.height) this.y = 0;
                        if (this.y < 0) this.y = canvas.height;
                    }
                    draw() {
                        ctx.beginPath();
                        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                        ctx.fillStyle = `rgba(255, 215, 0, ${this.opacity})`;
                        ctx.fill();
                    }
                }

                function init() {
                    particles = [];
                    for (let i = 0; i < 60; i++) {
                        particles.push(new Particle());
                    }
                }

                function animate() {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    particles.forEach(p => {
                        p.update();
                        p.draw();
                    });
                    requestAnimationFrame(animate);
                }

                init();
                animate();
            }
        });
    </script>
</body>
