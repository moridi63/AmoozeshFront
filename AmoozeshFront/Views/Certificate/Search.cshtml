            left: calc(var(--number-box-left) * 0.42);
            width: calc(var(--number-box-width) * 0.42);
            height: calc(var(--number-box-height) * 0.42);
            font-size: calc(var(--number-box-font-size) * 0.42);
        }

        .cert-preview-stage .cert-box-date {
            top: calc(var(--date-box-top) * 0.42);
            left: calc(var(--date-box-left) * 0.42);
            width: calc(var(--date-box-width) * 0.42);
            height: calc(var(--date-box-height) * 0.42);
            font-size: calc(var(--date-box-font-size) * 0.42);
        }

        .cert-preview-stage .cert-box-logo1 {
            top: calc(var(--logo1-box-top) * 0.42);
            left: calc(var(--logo1-box-left) * 0.42);
            width: calc(var(--logo1-box-width) * 0.42);
            height: calc(var(--logo1-box-height) * 0.42);
            font-size: calc(var(--logo1-box-font-size) * 0.42);
        }

        .cert-preview-stage .cert-box-logo2 {
            top: calc(var(--logo2-box-top) * 0.42);
            left: calc(var(--logo2-box-left) * 0.42);
            width: calc(var(--logo2-box-width) * 0.42);
            height: calc(var(--logo2-box-height) * 0.42);
            font-size: calc(var(--logo2-box-font-size) * 0.42);
        }

        .cert-preview-stage .cert-box-title {
            top: calc(var(--title-box-top) * 0.42);
            left: calc(var(--title-box-left) * 0.42);
            width: calc(var(--title-box-width) * 0.42);
            height: calc(var(--title-box-height) * 0.42);
            font-size: calc(var(--title-box-font-size) * 0.42);
        }

        .cert-preview-stage .cert-box-barcode {
            top: calc(var(--barcode-box-top) * 0.42);
            left: calc(var(--barcode-box-left) * 0.42);
            width: calc(var(--barcode-box-width) * 0.42);
            height: calc(var(--barcode-box-height) * 0.42);
            font-size: calc(var(--barcode-box-font-size) * 0.42);
        }

        .cert-preview-stage .cert-box-maintext {
            top: calc(var(--maintext-box-top) * 0.42);
            left: calc(var(--maintext-box-left) * 0.42);
            width: calc(var(--maintext-box-width) * 0.42);
            height: calc(var(--maintext-box-height) * 0.42);
            font-size: calc(var(--maintext-box-font-size) * 0.42);
        }

        .cert-preview-stage .cert-box-ceo1 {
            top: calc(var(--ceo1-box-top) * 0.42);
            left: calc(var(--ceo1-box-left) * 0.42);
            width: calc(var(--ceo1-box-width) * 0.42);
            height: calc(var(--ceo1-box-height) * 0.42);
            font-size: calc(var(--ceo1-box-font-size) * 0.42);
        }

            .cert-preview-stage .cert-box-ceo1 .cert-signature-img {
                width: calc(var(--ceo1-signature-width) * 0.42);
                height: calc(var(--ceo1-signature-height) * 0.42);
                top: var(--ceo1-signature-top-offset);
                left: var(--ceo1-signature-left-offset);
                transform: translate(-50%, -50%);
            }

        .cert-preview-stage .cert-box-ceo2 {
            top: calc(var(--ceo2-box-top) * 0.42);
            left: calc(var(--ceo2-box-left) * 0.42);
            width: calc(var(--ceo2-box-width) * 0.42);
            height: calc(var(--ceo2-box-height) * 0.42);
            font-size: calc(var(--ceo2-box-font-size) * 0.42);
        }

            .cert-preview-stage .cert-box-ceo2 .cert-signature-img {
                width: calc(var(--ceo2-signature-width) * 0.42);
                height: calc(var(--ceo2-signature-height) * 0.42);
                top: var(--ceo2-signature-top-offset);
                left: var(--ceo2-signature-left-offset);
                transform: translate(-50%, -50%);
            }

        .cert-preview-stage .cert-box-notice1 {
            top: calc(var(--notice1-box-top) * 0.42);
            left: calc(var(--notice1-box-left) * 0.42);
            width: calc(var(--notice1-box-width) * 0.42);
            height: calc(var(--notice1-box-height) * 0.42);
            font-size: calc(var(--notice1-box-font-size) * 0.42);
        }

        .cert-preview-stage .cert-box-notice2 {
            top: calc(var(--notice2-box-top) * 0.42);
            left: calc(var(--notice2-box-left) * 0.42);
            width: calc(var(--notice2-box-width) * 0.42);
            height: calc(var(--notice2-box-height) * 0.42);
            font-size: calc(var(--notice2-box-font-size) * 0.42);
        }

        /* ===== پس‌زمینه گواهینامه (روی همه + شیشه‌ای) ===== */
        .cert-bg-img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: fill;
            /* روی همه المان‌ها قرار می‌گیرد */
            z-index: 9999;
            pointer-events: none;
            /* حالت شیشه‌ای: سفیدیِ تصویر ناپدید می‌شود و طرح حاشیه روی متن می‌ماند */
            mix-blend-mode: multiply;
            opacity: 0.9;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        @@media (max-width: 991px) {
            .cert-preview-stage {
                position: static;
                width: 100%;
                aspect-ratio: 297 / 210;
            }
        }

        @@media print {
            .cert-page {
                box-shadow: none;
            }

                .cert-page:last-child {
                    page-break-after: avoid !important;
                    break-after: avoid !important;
                }
            /* پس‌زمینه روی همه در چاپ */
            .cert-bg-img {
                z-index: 9999 !important;
                mix-blend-mode: multiply !important;
                opacity: 0.9 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            /* شیشه‌ای کردن تمام تصاویر در زمان چاپ */
            img,
            .cert-box img,
            .cert-signature-img,
            .cert-box-logo1 img,
            .cert-box-logo2 img,
            .cert-box-barcode img,
            .cert-box-barcode svg {
                mix-blend-mode: multiply !important;
                background: transparent !important;
                opacity: 0.98 !important;
            }

            .cert-signature-img {
                width: var(--ceo1-signature-width, 60mm) !important;
                height: var(--ceo1-signature-height, 25mm) !important;
                top: var(--ceo1-signature-top-offset, 50%) !important;
                left: var(--ceo1-signature-left-offset, 50%) !important;
                object-fit: contain !important;
            }

            .cert-box-ceo2 .cert-signature-img {
                width: var(--ceo2-signature-width, 60mm) !important;
                height: var(--ceo2-signature-height, 25mm) !important;
                top: var(--ceo2-signature-top-offset, 50%) !important;
                left: var(--ceo2-signature-left-offset, 50%) !important;
            }
        }
    </style>
</head>
<body>

    <canvas id="particles-canvas"></canvas>

    <div class="container page-container" dir="rtl">
        <div class="row justify-content-center mb-5">
            <div class="col-md-7 text-center">
                <h2 class="fw-bold mb-3 gradient-text">سامانه هوشمند استعلام گواهینامه‌ها</h2>
                <p class="text-muted-custom fs-6">جهت مشاهده گواهینامه‌های آموزشی خود، کد ملی ده رقمی را وارد نمایید.</p>
                <div class="d-flex justify-content-center flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-settings-cert" data-bs-toggle="modal" data-bs-target="#certSettingsModal">
                        <i class="bi bi-gear"></i> تنظیمات قالب چاپ گواهینامه
                    </button>
                    <button type="button" class="btn btn-settings-cert" id="btnPrintAllDb">
                        <i class="bi bi-printer-fill"></i> چاپ تمام گواهینامه‌های سیستم
                    </button>
                    <label class="btn btn-settings-cert d-flex align-items-center gap-2 mb-0" style="cursor:pointer;">
                        <input type="checkbox" class="form-check-input cert-bg-toggle m-0" id="chkPrintBackground">
                        <span>چاپ همراه با پس‌زمینه (طرح حاشیه)</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card search-card p-4 p-md-5 mb-5">
                    <form asp-action="Search" method="post" id="searchForm">

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 text-white mb-4" style="background: rgba(220, 53, 69, 0.2); border-right: 4px solid #dc3545 !important; border-radius: 12px;">
                                <div asp-validation-summary="All" class="text-danger small"></div>
                            </div>
                        }

                        <div class="mb-4">
                            <label asp-for="NationalCode" class="form-label text-light fw-semibold mb-2">کد ملی</label>
                            <div class="position-relative">
                                <input asp-for="NationalCode"
                                       class="form-control form-control-custom text-center"
                                       placeholder="مثال: 1234567890"
                                       maxlength="10"
                                       autocomplete="off" />
                            </div>
                            <span asp-validation-for="NationalCode" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-gold w-100 d-flex align-items-center justify-content-center gap-2 py-3">
                            <span>بررسی و استعلام</span>
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @if (Model != null && Model.HasSearched)
        {
            <div class="row justify-content-center mt-4">
                <div class="col-md-10">
                    @if (Model.Results != null && Model.Results.Any())
                    {
                        <h4 class="mb-4 text-light fw-bold d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge badge-gold">@Model.Results.Count</span>
                                <span>گواهینامه‌های یافت شده</span>
                            </div>
                            <button type="button" class="btn btn-gold btn-sm d-flex align-items-center gap-2" onclick="printAllCertificates()">
                                <i class="bi bi-printer-fill"></i>
                                <span>چاپ همه گواهینامه‌ها</span>
                            </button>
                        </h4>

                        <div class="row g-4">
                            @{
                                var certIndex = 0;
                            }
                            @foreach (var cert in Model.Results)
                            {
                                var genderTitle = cert.Gender ? "جناب آقای" : "سرکار خانم";
                                <div class="col-md-6">
                                    <div class="card certificate-card h-100 p-4">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="text-white fw-bold mb-0">
                                                <i class="bi bi-award text-warning me-1"></i> @cert.ExamTitle
                                            </h5>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge badge-gold">شماره: @cert.CertificateNumber</span>
                                                <button type="button"
                                                        class="btn btn-print-cert"
                                                        onclick="printCertificate(@certIndex)"
                                                        title="پرینت گواهینامه">
                                                    <i class="bi bi-printer"></i> پرینت
                                                </button>
                                            </div>
                                        </div>

                                        <hr class="border-secondary opacity-25 my-3">

                                        <div class="row g-3">
                                            <div class="col-sm-6">
                                                <div class="mb-2">
                                                    <span class="text-muted-custom">نام و نام خانوادگی:</span>
                                                    <span class="info-value ms-1">@cert.FullName</span>
                                                </div>
                                                <div class="mb-2">
                                                    <span class="text-muted-custom">نام پدر:</span>
                                                    <span class="info-value ms-1">@cert.FatherName</span>
                                                </div>
                                                <div class="mb-2">
                                                    <span class="text-muted-custom">کد ملی:</span>
                                                    <span class="info-value ms-1">@Model.NationalCode</span>
                                                </div>
                                                <div class="mb-2">
                                                    <span class="text-muted-custom">جنسیت:</span>
                                                    <span class="info-value ms-1">@genderTitle</span>
                                                </div>
                                            </div>

                                            <div class="col-sm-6">
                                                <div class="mb-2">
                                                    <span class="text-muted-custom">نام شرکت / ارگان:</span>
                                                    <span class="info-value ms-1">@cert.CompanyName</span>
                                                </div>
                                                <div class="mb-2">
                                                    <span class="text-muted-custom">تاریخ آزمون:</span>
                                                    <span class="info-value ms-1">
                                                        @(cert.ExamDate.HasValue? cert.ExamDate.Value.ToString("yyyy/MM/dd") : (!string.IsNullOrEmpty(cert.ExamDatePersian) ? cert.ExamDatePersian : "ثبت نشده"))
                                                    </span>
                                                </div>
                                                <div class="mb-2">
                                                    <div class="qr-code-container">
                                                        <span class="text-muted-custom">بارکد دوبعدی:</span>
                                                        @if (!string.IsNullOrEmpty(cert.QRCodeBase64))
                                                        {
                                                            <img src="data:image/png;base64,@cert.QRCodeBase64"
                                                                 class="qr-code-small"
                                                                 onclick="showQRCodeModal('@cert.QRCodeBase64', '@cert.FullName', '@cert.CertificateNumber')"
                                                                 title="برای بزرگنمایی کلیک کنید"
                                                                 alt="QR Code" />
                                                            <span class="qr-code-label">
                                                                <i class="bi bi-info-circle"></i> کلیک کنید
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted-custom">بارکد موجود نیست</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mt-3 pt-2 border-top border-secondary border-opacity-25 align-items-center">
                                            <div class="col-6">
                                                <span class="text-muted-custom">مدت دوره:</span>
                                                <span class="badge bg-secondary ms-1">@(cert.DurationHours.HasValue ? $"{cert.DurationHours} ساعت" : "نامشخص")</span>
                                            </div>
                                            <div class="col-6 text-end">
                                                <span class="badge bg-opacity-10 bg-success text-success border border-success px-3 py-1">
                                                    @cert.StatusDisplay
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                certIndex++;
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-5 rounded-4 border border-secondary border-opacity-25" style="background: rgba(255,255,255,0.02);">
                            <i class="bi bi-exclamation-triangle text-warning display-4 mb-3 d-block"></i>
                            <h5 class="text-white fw-bold">هیچ گواهینامه‌ای یافت نشد</h5>
                            <p class="text-muted-custom small mb-0">برای کد ملی وارد شده، اطلاعاتی در سامانه آموزش ثبت نشده است.</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Modal QR Code -->
    <div class="modal fade" id="qrCodeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content modal-content-dark">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-white" id="qrModalTitle">
                        <i class="bi bi-qr-code text-warning"></i> بارکد گواهینامه
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <div class="qr-modal-image-container">
                        <img id="qrModalImage" src="" alt="QR Code" style="width: 250px; height: 250px;" />
                    </div>
                    <div class="mt-3">
                        <span class="text-light" id="qrModalInfo">اسکن کنید</span>
                    </div>
                    <div class="mt-2">
                        <span class="badge bg-warning text-dark px-3 py-2">برای تایید گواهینامه اسکن کنید</span>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center gap-2">
                    <button type="button" class="btn btn-sm btn-gold" onclick="downloadQRCode()">
                        <i class="bi bi-download"></i> دانلود QR Code
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-white" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i> بستن
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- قالب پرینت -->
    <div id="printCertificateTemplate"></div>

    <!-- مودال تنظیمات قالب چاپ -->
    <div class="modal fade" id="certSettingsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content" data-bs-theme="light">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">تنظیمات قالب چاپ گواهینامه</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <p class="text-muted small mb-3">
                                مقادیر هر کادر با پیش‌فرض پر شده‌اند. تغییرات بلافاصله در پیش‌نمایش اعمال شده و پس از کلیک روی دکمه "ذخیره تنظیمات" ذخیره می‌شوند.
                            </p>

                            <div class="cert-box-field-group">
                                <h6><i class="bi bi-image"></i> پس‌زمینه گواهینامه</h6>
                                <div class="form-check form-switch">
                                    <input class="form-check-input cert-bg-toggle" type="checkbox" role="switch" id="chkPrintBackgroundModal">
                                    <label class="form-check-label" for="chkPrintBackgroundModal">چاپ همراه با پس‌زمینه</label>
                                </div>
                            </div>

                            <div class="cert-box-field-group">
                                <h6><i class="bi bi-image"></i> لوگوها</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="fw-bold">لوگو ۱ (سمت راست)</label>
                                        <div class="d-flex align-items-center gap-2">
                                            <img id="logo1Thumb" src="" alt="" style="width:48px;height:48px;object-fit:contain;border:1px solid rgba(255,215,0,0.35);border-radius:6px;display:none;background:rgba(255,255,255,0.06);backdrop-filter:blur(6px);mix-blend-mode:multiply;">
                                            <input type="file" id="logo1UploadInput" class="form-control form-control-sm" accept="image/*">
                                            <button type="button" id="logo1RemoveBtn" class="btn btn-sm btn-outline-danger">حذف</button>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="fw-bold">لوگو ۲ (سمت چپ)</label>
                                        <div class="d-flex align-items-center gap-2">
                                            <img id="logo2Thumb" src="" alt="" style="width:48px;height:48px;object-fit:contain;border:1px solid rgba(255,215,0,0.35);border-radius:6px;display:none;background:rgba(255,255,255,0.06);backdrop-filter:blur(6px);mix-blend-mode:multiply;">
                                            <input type="file" id="logo2UploadInput" class="form-control form-control-sm" accept="image/*">
                                            <button type="button" id="logo2RemoveBtn" class="btn btn-sm btn-outline-danger">حذف</button>
                                        </div>
                                    </div>
                                </div>
                                <small class="text-muted mt-2 d-block">لوگوها با حالت <code>mix-blend-mode: multiply</code> و شفافیت کم در پشت متن نمایش داده می‌شوند.</small>
                            </div>

                            <div class="cert-box-field-group">
                                <h6><i class="bi bi-card-text"></i> متن‌های قابل ویرایش</h6>
                                <div class="row g-2">
                                    <div class="col-md-12">
                                        <label>عنوان سر تیتر</label>
                                        <input type="text" class="form-control form-control-sm" id="text-certTitle">
                                    </div>
                                    <div class="col-md-6">
                                        <label>نام مدیرعامل (چپ)</label>
                                        <input type="text" class="form-control form-control-sm" id="text-ceo1Name">
                                    </div>
                                    <div class="col-md-6">
                                        <label>سمت مدیرعامل (چپ)</label>
                                        <input type="text" class="form-control form-control-sm" id="text-ceo1Title">
                                    </div>
                                    <div class="col-md-6">
                                        <label>نام مدیرعامل دوم (راست)</label>
                                        <input type="text" class="form-control form-control-sm" id="text-ceo2Name">
                                    </div>
                                    <div class="col-md-6">
                                        <label>سمت مدیرعامل دوم (راست)</label>
                                        <input type="text" class="form-control form-control-sm" id="text-ceo2Title">
                                    </div>
                                </div>
                            </div>

                            <div class="cert-box-field-group">
                                <h6><i class="bi bi-exclamation-circle"></i> متن‌های توضیحی (خطوط قانونی)</h6>
                                <div class="row g-2">
                                    <div class="col-md-12">
                                        <label>خط اول (محدودیت اعتبار به شرکت)</label>
                                        <textarea class="form-control form-control-sm" id="text-notice1" rows="2"></textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <label>خط دوم (مدت اعتبار و آزمون عملی)</label>
                                        <textarea class="form-control form-control-sm" id="text-notice2" rows="2"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="cert-box-field-group">
                                <h6><i class="bi bi-pen"></i> امضاها</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="fw-bold">امضای مدیرعامل (چپ)</label>
                                        <div class="signature-container">
                                            <img id="ceo1SigThumb" class="signature-thumb" src="" alt="امضا" style="display:none;" />
                                            <input type="file" id="ceo1SigUpload" class="form-control form-control-sm" accept="image/*" />
                                            <button type="button" id="ceo1SigRemove" class="btn btn-sm btn-outline-danger">حذف امضا</button>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="fw-bold">امضای مدیرعامل (راست)</label>
                                        <div class="signature-container">
