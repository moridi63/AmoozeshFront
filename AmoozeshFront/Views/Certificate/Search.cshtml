    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        window.certificatesData = @Html.Raw(certificatesJson);
        var CERT_BG_URL = '@Url.Content("~/images/certificate-bg.png")';
        let currentQRBase64 = '';
        let currentQRInfo = '';

        function toPersianNumber(num) {
            if (num === undefined || num === null) return '';
            var persianDigits = '۰۱۲۳۴۵۶۷۸۹';
            return String(num).replace(/\d/g, function (m) {
                return persianDigits[parseInt(m)];
            });
        }

        function toPersianDate(dateStr) {
            if (!dateStr) return '';
            try {
                var parts = dateStr.split('/');
                if (parts.length === 3) {
                    var year = parseInt(parts[0]);
                    var month = parseInt(parts[1]);
                    var day = parseInt(parts[2]);
                    var date = new Date(year, month - 1, day);
                    if (!isNaN(date.getTime())) {
                        return date.toLocaleDateString('fa-IR', {
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit'
                        }).replace(/\//g, '/');
                    }
                }
                return dateStr;
            } catch (e) {
                return dateStr;
            }
        }

        function showQRCodeModal(base64, fullName, certNumber) {
            currentQRBase64 = base64;
            currentQRInfo = `${fullName} - شماره: ${certNumber}`;
            document.getElementById('qrModalImage').src = `data:image/png;base64,${base64}`;
            document.getElementById('qrModalTitle').textContent = `بارکد گواهینامه ${certNumber}`;
            document.getElementById('qrModalInfo').textContent = currentQRInfo;

            var modal = new bootstrap.Modal(document.getElementById('qrCodeModal'));
            modal.show();
        }

        function downloadQRCode() {
            if (!currentQRBase64) return;
            const link = document.createElement('a');
            link.download = `QRCode_${currentQRInfo.replace(/\s/g, '_')}.png`;
            link.href = `data:image/png;base64,${currentQRBase64}`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function renderSingleCertHtml(data, settings) {
            var options = { year: 'numeric', month: '2-digit', day: '2-digit' };
            var todayPersian = new Date().toLocaleDateString('fa-IR', options);

            var genderTitle = data.gender === true ? 'جناب آقای' : 'سرکار خانم';

            var bgHtml = settings.useBackground
                ? '<img class="cert-bg-img" src="' + CERT_BG_URL + '" alt="" />'
                : '';

            var qrHtml = data.qrCodeBase64
                ? `<img src="data:image/png;base64,${data.qrCodeBase64}" style="max-width:100%;max-height:100%;object-fit:contain;mix-blend-mode:multiply;background:transparent;opacity:0.98;" alt="QR Code" />`
                : '<span style="font-size:10pt;">---</span>';

            var logo1Html = settings.logo1Src
                ? `<img src="${settings.logo1Src}" alt="لوگو ۱" style="mix-blend-mode:multiply;background:transparent;opacity:0.95;max-width:100%;max-height:100%;" />`
                : '';

            var logo2Html = settings.logo2Src
                ? `<img src="${settings.logo2Src}" alt="لوگو ۲" style="mix-blend-mode:multiply;background:transparent;opacity:0.95;max-width:100%;max-height:100%;" />`
                : '';

            var ceo1SigStyle = settings.ceo1Sig
                ? `src="${settings.ceo1Sig}" style="display:block;width:${settings.ceo1SigWidth || 60}mm;height:${settings.ceo1SigHeight || 25}mm;top:${settings.ceo1SigTopOffset || 50}%;left:${settings.ceo1SigLeftOffset || 50}%;object-fit:contain;position:absolute;transform:translate(-50%, -50%);z-index:1;pointer-events:none;mix-blend-mode:multiply;background:transparent;opacity:0.95;"`
                : 'src="" style="display:none;"';

            var ceo2SigStyle = settings.ceo2Sig
                ? `src="${settings.ceo2Sig}" style="display:block;width:${settings.ceo2SigWidth || 60}mm;height:${settings.ceo2SigHeight || 25}mm;top:${settings.ceo2SigTopOffset || 50}%;left:${settings.ceo2SigLeftOffset || 50}%;object-fit:contain;position:absolute;transform:translate(-50%, -50%);z-index:1;pointer-events:none;mix-blend-mode:multiply;background:transparent;opacity:0.95;"`
                : 'src="" style="display:none;"';

            var certNumberPersian = toPersianNumber(data.certNumber);
            var examDatePersian = toPersianDate(data.examDate);
            var nationalCodePersian = toPersianNumber(data.nationalCode);

            return `
                        <div class="cert-page">
                            ${bgHtml}
                            <div class="cert-box cert-box-number">شماره: <span>${certNumberPersian || '---'}</span></div>
                            <div class="cert-box cert-box-date">تاریخ: <span>${todayPersian}</span></div>
                            <div class="cert-box cert-box-logo1">${logo1Html}</div>
                            <div class="cert-box cert-box-logo2">${logo2Html}</div>
                            <div class="cert-box cert-box-title">
                                <span>${settings.texts.certTitle || 'گواهینامه آموزشی'}</span>
                            </div>
                            <div class="cert-box cert-box-barcode">${qrHtml}</div>
                            <div class="cert-box cert-box-maintext">
                                <p style="margin:0;">
                                    بدین وسیله گواهی می‌شود
                                    <span style="font-weight:bold;">${genderTitle}</span>
                                    <span class="cert-fill">${data.fullName || ''}</span>
                                    فرزند
                                    <span class="cert-fill">${data.fatherName || ''}</span>
                                    به شماره ملی
                                    <span class="cert-fill">${nationalCodePersian || ''}</span>
                                    از سوی شرکت
                                    <span class="cert-fill">${data.companyName || ''}</span>
                                    در آزمون
                                    <span class="cert-fill">${data.examTitle || ''}</span>
                                    مورخ
                                    <span class="cert-fill">${examDatePersian || ''}</span>
                                    شرکت نموده و حائز نمره قبول گردیده است.
                                </p>
                            </div>
                            <div class="cert-box cert-box-notice1">
                                <span>${settings.texts.notice1 || ''}</span>
                            </div>
                            <div class="cert-box cert-box-notice2">
                                <span>${settings.texts.notice2 || ''}</span>
                            </div>
                            <div class="cert-box cert-box-ceo1">
                                <img class="cert-signature-img" ${ceo1SigStyle} alt="امضا" />
                                <div style="font-weight:normal !important;">${settings.texts.ceo1Name || ''}</div>
                                <div class="cert-sig-title" style="font-weight:normal !important;">${settings.texts.ceo1Title || ''}</div>
                            </div>
                            <div class="cert-box cert-box-ceo2">
                                <img class="cert-signature-img" ${ceo2SigStyle} alt="امضا" />
                                <div style="font-weight:normal !important;">${settings.texts.ceo2Name || ''}</div>
                                <div class="cert-sig-title" style="font-weight:normal !important;">${settings.texts.ceo2Title || ''}</div>
                            </div>
                        </div>
                    `;
        }

        function printWhenReady() {
            var imgs = Array.from(document.querySelectorAll('#printCertificateTemplate img'));
            var waits = imgs.map(function (img) {
                if (img.complete) return Promise.resolve();
                return new Promise(function (resolve) {
                    img.addEventListener('load', resolve, { once: true });
                    img.addEventListener('error', resolve, { once: true });
                });
            });
            var timeout = new Promise(function (r) { setTimeout(r, 5000); });
            Promise.race([Promise.all(waits), timeout]).then(function () {
                setTimeout(function () { window.print(); }, 100);
            });
        }

        function printCertificate(index) {
            var data = window.certificatesData[index];
            if (!data) return;

            var settings = loadSettings();
            var template = document.getElementById('printCertificateTemplate');
            template.innerHTML = renderSingleCertHtml(data, settings);

            document.body.classList.add('is-printing-cert');
            printWhenReady();
        }

        function printAllCertificates(dataList) {
            var list = dataList || window.certificatesData;

            if (!list || list.length === 0) {
                alert('هیچ گواهینامه‌ای برای چاپ وجود ندارد.');
                return;
            }

            var settings = loadSettings();
            var htmlContent = '';

            list.forEach(function (data) {
                htmlContent += renderSingleCertHtml(data, settings);
            });

            var template = document.getElementById('printCertificateTemplate');
            template.innerHTML = htmlContent;

            document.body.classList.add('is-printing-cert');
            printWhenReady();
        }

        function printAllFromDatabase() {
            var btn = document.getElementById('btnPrintAllDb');
            var originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> در حال دریافت اطلاعات...';

            fetch('/Certificates/GetAllForPrint', {
                method: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(function (res) { return res.json(); })
                .then(function (result) {
                    if (!result.success) {
                        alert(result.message || 'خطا در دریافت اطلاعات گواهینامه‌ها.');
                        return;
                    }
                    if (!result.data || result.data.length === 0) {
                        alert('هیچ گواهینامه‌ای در سیستم ثبت نشده است.');
                        return;
                    }
                    printAllCertificates(result.data);
                })
                .catch(function (err) {
                    console.error(err);
                    alert('خطا در برقراری ارتباط با سرور.');
                })
                .finally(function () {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                });
        }

        window.addEventListener('afterprint', function () {
            document.body.classList.remove('is-printing-cert');
        });

        var STORAGE_KEY = 'certTemplateSettingsV5';

        var BOX_DEFS = [
            { key: 'number', label: 'شماره' },
            { key: 'date', label: 'تاریخ' },
            { key: 'logo1', label: 'لوگو ۱ (راست)' },
            { key: 'logo2', label: 'لوگو ۲ (چپ)' },
            { key: 'title', label: 'عنوان سر تیتر' },
            { key: 'barcode', label: 'بارکد' },
            { key: 'maintext', label: 'متن اصلی' },
            { key: 'ceo1', label: 'مدیرعامل (چپ)' },
            { key: 'ceo2', label: 'مدیرعامل دوم (راست)' },
            { key: 'notice1', label: 'توضیح خط اول (محدودیت شرکت)' },
            { key: 'notice2', label: 'توضیح خط دوم (اعتبار و آزمون عملی)' }
        ];

        var PREVIEW_ELEMENT_MAP = {
            number: 'previewNumber',
            date: 'previewDate',
            logo1: 'previewLogo1',
            logo2: 'previewLogo2',
            title: 'previewTitle',
            barcode: 'previewBarcode',
            maintext: 'previewMaintext',
            ceo1: 'previewCeo1',
            ceo2: 'previewCeo2',
            notice1: 'previewNotice1',
            notice2: 'previewNotice2'
        };

        var FONT_OPTIONS = [
            { value: "'B Nazanin', Tahoma, Arial, sans-serif", label: 'B Nazanin' },
            { value: "'B Titr', Tahoma, Arial, sans-serif", label: 'B Titr' },
            { value: "Tahoma, Arial, sans-serif", label: 'Tahoma' },
            { value: "'IRANSans', Tahoma, Arial, sans-serif", label: 'IRANSans' },
            { value: "Arial, sans-serif", label: 'Arial' },
            { value: "'IranNastaliq', 'Nastaliq', serif", label: 'نستعلیق' }
        ];

        var DEFAULT_SETTINGS = {
            number: { top: 15, left: 12, width: 45, height: 10, font: FONT_OPTIONS[0].value, size: 12 },
            date: { top: 27, left: 12, width: 45, height: 10, font: FONT_OPTIONS[0].value, size: 12 },
            logo1: { top: 8, left: 128, width: 40, height: 16, font: FONT_OPTIONS[0].value, size: 12 },
            logo2: { top: 8, left: 10, width: 40, height: 16, font: FONT_OPTIONS[0].value, size: 12 },
            title: { top: 26, left: 108, width: 80, height: 16, font: FONT_OPTIONS[0].value, size: 14 },
            barcode: { top: 15, left: 235, width: 45, height: 18, font: FONT_OPTIONS[0].value, size: 10 },
            maintext: { top: 62, left: 35, width: 227, height: 40, font: FONT_OPTIONS[5].value, size: 15 },
            ceo1: { top: 110, left: 35, width: 55, height: 28, font: FONT_OPTIONS[5].value, size: 13 },
            ceo2: { top: 110, left: 207, width: 55, height: 28, font: FONT_OPTIONS[5].value, size: 13 },
            notice1: { top: 103, left: 20, width: 257, height: 9, font: FONT_OPTIONS[0].value, size: 11 },
            notice2: { top: 196, left: 20, width: 257, height: 9, font: FONT_OPTIONS[0].value, size: 10 },
            texts: {
                certTitle: 'گواهینامه آموزشی',
                ceo1Name: 'محمد وحیدی',
                ceo1Title: 'مدیر عامل مرکز آموزش بازرگانی',
                ceo2Name: 'عباس ابریشمی',
                ceo2Title: 'رییس اتحادیه آسانسور، پله برقی و خدمات وابسته',
                notice1: 'این گواهینامه به منزله قبولی در آزمون و فعالیت در شرکت مذکور صادر گردیده و فاقد اعتبار جهت فعالیت در سایر شرکت‌ها می‌باشد.',
                notice2: 'اعتبار این گواهینامه ۶ ماه از تاریخ آزمون بوده و قبولی نهایی منوط به پذیرفته شدن در آزمون عملی اتحادیه کشوری می‌باشد.'
            },
            logo1Src: '',
            logo2Src: '',
            ceo1Sig: '',
            ceo2Sig: '',
            useBackground: false,
            ceo1SigWidth: 60,
            ceo1SigHeight: 25,
            ceo1SigTopOffset: 50,
            ceo1SigLeftOffset: 50,
            ceo2SigWidth: 60,
            ceo2SigHeight: 25,
            ceo2SigTopOffset: 50,
            ceo2SigLeftOffset: 50
        };

        function cloneDefaults() {
            return JSON.parse(JSON.stringify(DEFAULT_SETTINGS));
        }

        function loadSettings() {
            var settings = cloneDefaults();
            try {
                var raw = localStorage.getItem(STORAGE_KEY);
                if (raw) {
                    var saved = JSON.parse(raw);
                    BOX_DEFS.forEach(function (box) {
                        if (saved[box.key]) {
                            settings[box.key] = Object.assign({}, settings[box.key], saved[box.key]);
                        }
                    });
                    if (saved.texts) {
                        settings.texts = Object.assign({}, settings.texts, saved.texts);
                    }
                    if (typeof saved.logo1Src === 'string') settings.logo1Src = saved.logo1Src;
                    if (typeof saved.logo2Src === 'string') settings.logo2Src = saved.logo2Src;
                    if (typeof saved.ceo1Sig === 'string') settings.ceo1Sig = saved.ceo1Sig;
                    if (typeof saved.ceo2Sig === 'string') settings.ceo2Sig = saved.ceo2Sig;
                    if (typeof saved.useBackground === 'boolean') settings.useBackground = saved.useBackground;
                    if (typeof saved.ceo1SigWidth === 'number') settings.ceo1SigWidth = saved.ceo1SigWidth;
                    if (typeof saved.ceo1SigHeight === 'number') settings.ceo1SigHeight = saved.ceo1SigHeight;
                    if (typeof saved.ceo1SigTopOffset === 'number') settings.ceo1SigTopOffset = saved.ceo1SigTopOffset;
                    if (typeof saved.ceo1SigLeftOffset === 'number') settings.ceo1SigLeftOffset = saved.ceo1SigLeftOffset;
                    if (typeof saved.ceo2SigWidth === 'number') settings.ceo2SigWidth = saved.ceo2SigWidth;
                    if (typeof saved.ceo2SigHeight === 'number') settings.ceo2SigHeight = saved.ceo2SigHeight;
                    if (typeof saved.ceo2SigTopOffset === 'number') settings.ceo2SigTopOffset = saved.ceo2SigTopOffset;
                    if (typeof saved.ceo2SigLeftOffset === 'number') settings.ceo2SigLeftOffset = saved.ceo2SigLeftOffset;
                }
            } catch (e) {
                console.error('خطا در خواندن تنظیمات ذخیره‌شده:', e);
            }
            return settings;
        }

        function saveSettings(settings) {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
            } catch (e) {
                console.error('خطا در ذخیره تنظیمات:', e);
            }
        }

        function applySettings(settings) {
            var root = document.documentElement.style;
            BOX_DEFS.forEach(function (box) {
                var b = settings[box.key];
                if (!b) return;
                root.setProperty('--' + box.key + '-box-top', b.top + 'mm');
                root.setProperty('--' + box.key + '-box-left', b.left + 'mm');
                root.setProperty('--' + box.key + '-box-width', b.width + 'mm');
                root.setProperty('--' + box.key + '-box-height', b.height + 'mm');
                root.setProperty('--' + box.key + '-box-font-family', b.font);
                root.setProperty('--' + box.key + '-box-font-size', b.size + 'pt');
            });

            root.setProperty('--ceo1-signature-width', (settings.ceo1SigWidth || 60) + 'mm');
            root.setProperty('--ceo1-signature-height', (settings.ceo1SigHeight || 25) + 'mm');
            root.setProperty('--ceo1-signature-top-offset', (settings.ceo1SigTopOffset || 50) + '%');
            root.setProperty('--ceo1-signature-left-offset', (settings.ceo1SigLeftOffset || 50) + '%');
            root.setProperty('--ceo2-signature-width', (settings.ceo2SigWidth || 60) + 'mm');
            root.setProperty('--ceo2-signature-height', (settings.ceo2SigHeight || 25) + 'mm');
            root.setProperty('--ceo2-signature-top-offset', (settings.ceo2SigTopOffset || 50) + '%');
            root.setProperty('--ceo2-signature-left-offset', (settings.ceo2SigLeftOffset || 50) + '%');

            updateFullPreview(settings);
        }

        function applyBackgroundPreview(settings) {
            var img = document.getElementById('pBgPreview');
            if (img) {
                if (settings.useBackground) {
                    if (img.getAttribute('src') !== CERT_BG_URL) {
                        img.src = CERT_BG_URL;
                    }
                    img.style.display = 'block';
                } else {
                    img.style.display = 'none';
                }
            }
            document.querySelectorAll('.cert-bg-toggle').forEach(function (chk) {
                chk.checked = !!settings.useBackground;
            });
        }

        function updateFullPreview(settings) {
            applyBackgroundPreview(settings);

            setText('pCertTitlePreview', settings.texts.certTitle);
            setText('pCeo1NamePreview', settings.texts.ceo1Name);
            setText('pCeo1TitlePreview', settings.texts.ceo1Title);
            setText('pCeo2NamePreview', settings.texts.ceo2Name);
            setText('pCeo2TitlePreview', settings.texts.ceo2Title);
            setText('pNotice1Preview', settings.texts.notice1);
            setText('pNotice2Preview', settings.texts.notice2);

            setLogoSrc('pLogo1Preview', settings.logo1Src);
            setLogoSrc('pLogo2Preview', settings.logo2Src);

            updateLogoThumb('logo1Thumb', settings.logo1Src);
            updateLogoThumb('logo2Thumb', settings.logo2Src);

            applySignaturePreview(settings);

            BOX_DEFS.forEach(function (box) {
                var previewEl = document.getElementById(PREVIEW_ELEMENT_MAP[box.key]);
                if (previewEl) {
                    var b = settings[box.key];
                    if (b) {
                        previewEl.style.fontFamily = b.font;
                    }
                }
            });
        }

        function updateLogoThumb(thumbId, src) {
            var thumb = document.getElementById(thumbId);
            if (thumb) {
                if (src) {
                    thumb.src = src;
                    thumb.style.display = 'inline-block';
                } else {
                    thumb.style.display = 'none';
                }
            }
        }

        function applySignaturePreview(settings) {
            var ceo1SigPreview = document.getElementById('pCeo1SigPreview');
            var ceo2SigPreview = document.getElementById('pCeo2SigPreview');
            var ceo1Thumb = document.getElementById('ceo1SigThumb');
            var ceo2Thumb = document.getElementById('ceo2SigThumb');

            if (settings.ceo1Sig) {
                if (ceo1SigPreview) {
                    ceo1SigPreview.src = settings.ceo1Sig;
                    ceo1SigPreview.style.display = 'block';
                    ceo1SigPreview.style.width = (settings.ceo1SigWidth || 60) + 'mm';
                    ceo1SigPreview.style.height = (settings.ceo1SigHeight || 25) + 'mm';
                    ceo1SigPreview.style.top = (settings.ceo1SigTopOffset || 50) + '%';
                    ceo1SigPreview.style.left = (settings.ceo1SigLeftOffset || 50) + '%';
                }
                if (ceo1Thumb) { ceo1Thumb.src = settings.ceo1Sig; ceo1Thumb.style.display = 'inline-block'; }
            } else {
                if (ceo1SigPreview) ceo1SigPreview.style.display = 'none';
                if (ceo1Thumb) ceo1Thumb.style.display = 'none';
            }

            if (settings.ceo2Sig) {
                if (ceo2SigPreview) {
                    ceo2SigPreview.src = settings.ceo2Sig;
                    ceo2SigPreview.style.display = 'block';
                    ceo2SigPreview.style.width = (settings.ceo2SigWidth || 60) + 'mm';
                    ceo2SigPreview.style.height = (settings.ceo2SigHeight || 25) + 'mm';
                    ceo2SigPreview.style.top = (settings.ceo2SigTopOffset || 50) + '%';
                    ceo2SigPreview.style.left = (settings.ceo2SigLeftOffset || 50) + '%';
                }
                if (ceo2Thumb) { ceo2Thumb.src = settings.ceo2Sig; ceo2Thumb.style.display = 'inline-block'; }
            } else {
                if (ceo2SigPreview) ceo2SigPreview.style.display = 'none';
                if (ceo2Thumb) ceo2Thumb.style.display = 'none';
            }
        }

        function setText(id, value) {
            var el = document.getElementById(id);
            if (el) el.textContent = value || '';
        }

        function setLogoSrc(id, src) {
            var el = document.getElementById(id);
            if (el) {
                el.src = src || '';
                if (src) {
                    el.style.mixBlendMode = 'multiply';
                    el.style.background = 'transparent';
                    el.style.opacity = '0.95';
                }
            }
        }

        function fieldId(boxKey, prop) {
            return 'box-' + boxKey + '-' + prop;
        }

        function buildFontOptionsHtml(selected) {
            return FONT_OPTIONS.map(function (f) {
                var sel = f.value === selected ? ' selected' : '';
                return '<option value="' + f.value.replace(/"/g, '&quot;') + '"' + sel + '>' + f.label + '</option>';
            }).join('');
        }

        function getBoxPreviewContent(key, settings) {
            switch (key) {
                case 'number':
                    return 'شماره: ۱۲۳۴۵';
                case 'date':
                    return 'تاریخ: ۱۴۰۵/۰۵/۰۱';
                case 'logo1':
                    if (settings.logo1Src) {
                        return `<img src="${settings.logo1Src}" style="max-width:100%;max-height:100%;object-fit:contain;mix-blend-mode:multiply;background:transparent;opacity:0.95;" alt="لوگو ۱" />`;
                    }
                    return '<span style="color:#999;font-size:10pt;">(لوگو ۱)</span>';
                case 'logo2':
                    if (settings.logo2Src) {
                        return `<img src="${settings.logo2Src}" style="max-width:100%;max-height:100%;object-fit:contain;mix-blend-mode:multiply;background:transparent;opacity:0.95;" alt="لوگو ۲" />`;
                    }
                    return '<span style="color:#999;font-size:10pt;">(لوگو ۲)</span>';
                case 'barcode':
                    return '<span style="color:#999;font-size:10pt;">(بارکد)</span>';
                case 'title':
                    return settings.texts.certTitle || 'گواهینامه آموزشی';
                case 'maintext':
                    return 'بدین وسیله گواهی می‌شود جناب آقای/سرکار خانم نام نمونه فرزند نام پدر به شماره ملی ۰۰۰۰۰۰۰۰۰۰ از سوی شرکت نام شرکت در آزمون عنوان آزمون مورخ ۱۴۰۵/۰۱/۰۱ شرکت نموده و حائز نمره قبول گردیده است.';
                case 'ceo1':
                    return (settings.texts.ceo1Name || 'نام مدیرعامل') + '\n' + (settings.texts.ceo1Title || 'سمت');
                case 'ceo2':
                    return (settings.texts.ceo2Name || 'نام مدیرعامل') + '\n' + (settings.texts.ceo2Title || 'سمت');
                case 'notice1':
                    return settings.texts.notice1 || 'این گواهینامه به منزله قبولی در آزمون و فعالیت در شرکت مذکور صادر گردیده و فاقد اعتبار جهت فعالیت در سایر شرکت‌ها می‌باشد.';
                case 'notice2':
                    return settings.texts.notice2 || 'اعتبار این گواهینامه ۶ ماه از تاریخ آزمون بوده و قبولی نهایی منوط به پذیرفته شدن در آزمون عملی اتحادیه کشوری می‌باشد.';
                default:
                    return 'نمونه متن';
            }
        }

        function buildAccordionForm(settings) {
            var container = document.getElementById('certBoxAccordion');
            if (!container) return;

            var html = BOX_DEFS.map(function (box) {
                var b = settings[box.key];
                if (!b) return '';
                var previewContent = getBoxPreviewContent(box.key, settings);
                var previewStyle = 'background:#fff;color:#000;border:1px solid #ddd;border-radius:8px;' +
                    'padding:8px 12px;min-height:20px;overflow:auto;max-height:120px;' +
                    'display:flex;align-items:center;justify-content:center;' +
                    'font-family:' + b.font + ';font-size:' + b.size + 'pt;' +
                    'text-align:center;';

                if (box.key === 'ceo1' || box.key === 'ceo2') {
                    previewStyle += 'flex-direction:column;line-height:1.8;';
                }

                if (box.key === 'logo1' || box.key === 'logo2' || box.key === 'barcode') {
                    previewStyle += 'background:#f8f9fa;';
                }

                var signatureSettingsHtml = '';
                if (box.key === 'ceo1' || box.key === 'ceo2') {
                    var sigWidthKey = box.key === 'ceo1' ? 'ceo1SigWidth' : 'ceo2SigWidth';
                    var sigHeightKey = box.key === 'ceo1' ? 'ceo1SigHeight' : 'ceo2SigHeight';
                    var sigTopKey = box.key === 'ceo1' ? 'ceo1SigTopOffset' : 'ceo2SigTopOffset';
                    var sigLeftKey = box.key === 'ceo1' ? 'ceo1SigLeftOffset' : 'ceo2SigLeftOffset';
                    signatureSettingsHtml = `
                                <div class="row g-2 mt-2 border-top pt-2">
                                    <div class="col-3">
                                        <label><i class="bi bi-arrows-expand"></i> عرض (mm)</label>
                                        <input type="number" step="1" class="form-control form-control-sm" id="${box.key}-sig-width" value="${settings[sigWidthKey] || 60}">
                                    </div>
                                    <div class="col-3">
                                        <label><i class="bi bi-arrows-expand-vertical"></i> ارتفاع (mm)</label>
                                        <input type="number" step="1" class="form-control form-control-sm" id="${box.key}-sig-height" value="${settings[sigHeightKey] || 25}">
                                    </div>
                                    <div class="col-3">
                                        <label><i class="bi bi-arrow-up"></i> عمودی (%)</label>
                                        <input type="number" step="1" min="0" max="100" class="form-control form-control-sm" id="${box.key}-sig-top" value="${settings[sigTopKey] || 50}">
                                    </div>
                                    <div class="col-3">
                                        <label><i class="bi bi-arrow-left"></i> افقی (%)</label>
                                        <input type="number" step="1" min="0" max="100" class="form-control form-control-sm" id="${box.key}-sig-left" value="${settings[sigLeftKey] || 50}">
                                    </div>
                                </div>
                            `;
                }

                return '' +
                    '<div class="cert-box-field-group">' +
                    '  <h6><i class="bi bi-bounding-box"></i> ' + box.label + '</h6>' +
                    '  <div class="row g-2">' +
                    '    <div class="col-3"><label>بالا (mm)</label><input type="number" step="1" class="form-control form-control-sm" id="' + fieldId(box.key, 'top') + '" value="' + b.top + '"></div>' +
                    '    <div class="col-3"><label>چپ (mm)</label><input type="number" step="1" class="form-control form-control-sm" id="' + fieldId(box.key, 'left') + '" value="' + b.left + '"></div>' +
                    '    <div class="col-3"><label>عرض (mm)</label><input type="number" step="1" class="form-control form-control-sm" id="' + fieldId(box.key, 'width') + '" value="' + b.width + '"></div>' +
                    '    <div class="col-3"><label>ارتفاع (mm)</label><input type="number" step="1" class="form-control form-control-sm" id="' + fieldId(box.key, 'height') + '" value="' + b.height + '"></div>' +
                    '    <div class="col-8"><label>فونت</label><select class="form-select form-select-sm" id="' + fieldId(box.key, 'font') + '">' + buildFontOptionsHtml(b.font) + '</select></div>' +
                    '    <div class="col-4"><label>سایز فونت (pt)</label><input type="number" step="1" class="form-control form-control-sm" id="' + fieldId(box.key, 'size') + '" value="' + b.size + '"></div>' +
                    '    <div class="col-12">' +
                    '      <label class="d-block mb-1">پیش‌نمایش فونت و سایز (اندازه واقعی)</label>' +
                    '      <div id="preview-' + box.key + '" dir="rtl" style="' + previewStyle + '">' + previewContent + '</div>' +
                    '    </div>' +
                    signatureSettingsHtml +
                    '  </div>' +
                    '</div>';
            }).join('');

            container.innerHTML = html;

            BOX_DEFS.forEach(function (box) {
                ['top', 'left', 'width', 'height', 'size'].forEach(function (prop) {
                    var input = document.getElementById(fieldId(box.key, prop));
                    if (input) {
                        input.addEventListener('input', function () {
                            var num = parseFloat(input.value);
                            if (isNaN(num)) return;
                            if (!currentSettings[box.key]) currentSettings[box.key] = {};
                            currentSettings[box.key][prop] = num;
                            applySettings(currentSettings);
                            saveSettings(currentSettings);
                            refreshBoxPreview(box.key);
                        });
                    }
                });
                var fontSelect = document.getElementById(fieldId(box.key, 'font'));
                if (fontSelect) {
                    fontSelect.addEventListener('change', function () {
                        if (!currentSettings[box.key]) currentSettings[box.key] = {};
                        currentSettings[box.key].font = fontSelect.value;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview(box.key);
                    });
                }

                if (box.key === 'ceo1' || box.key === 'ceo2') {
                    var sigWidthInput = document.getElementById(box.key + '-sig-width');
                    var sigHeightInput = document.getElementById(box.key + '-sig-height');
                    var sigTopInput = document.getElementById(box.key + '-sig-top');
                    var sigLeftInput = document.getElementById(box.key + '-sig-left');

                    var sigWidthKey = box.key === 'ceo1' ? 'ceo1SigWidth' : 'ceo2SigWidth';
                    var sigHeightKey = box.key === 'ceo1' ? 'ceo1SigHeight' : 'ceo2SigHeight';
                    var sigTopKey = box.key === 'ceo1' ? 'ceo1SigTopOffset' : 'ceo2SigTopOffset';
                    var sigLeftKey = box.key === 'ceo1' ? 'ceo1SigLeftOffset' : 'ceo2SigLeftOffset';

                    if (sigWidthInput) {
                        sigWidthInput.addEventListener('input', function () {
                            var val = parseFloat(sigWidthInput.value);
                            if (!isNaN(val) && val > 0) {
                                currentSettings[sigWidthKey] = val;
                                applySettings(currentSettings);
                                saveSettings(currentSettings);
                                refreshBoxPreview(box.key);
                            }
                        });
                    }
                    if (sigHeightInput) {
                        sigHeightInput.addEventListener('input', function () {
                            var val = parseFloat(sigHeightInput.value);
                            if (!isNaN(val) && val > 0) {
                                currentSettings[sigHeightKey] = val;
                                applySettings(currentSettings);
                                saveSettings(currentSettings);
                                refreshBoxPreview(box.key);
                            }
                        });
                    }
                    if (sigTopInput) {
                        sigTopInput.addEventListener('input', function () {
                            var val = parseFloat(sigTopInput.value);
                            if (!isNaN(val) && val >= 0 && val <= 100) {
                                currentSettings[sigTopKey] = val;
                                applySettings(currentSettings);
                                saveSettings(currentSettings);
                                refreshBoxPreview(box.key);
                            }
                        });
                    }
                    if (sigLeftInput) {
                        sigLeftInput.addEventListener('input', function () {
                            var val = parseFloat(sigLeftInput.value);
                            if (!isNaN(val) && val >= 0 && val <= 100) {
                                currentSettings[sigLeftKey] = val;
                                applySettings(currentSettings);
                                saveSettings(currentSettings);
                                refreshBoxPreview(box.key);
                            }
                        });
                    }
                }
            });
        }

        function refreshBoxPreview(key) {
            var el = document.getElementById('preview-' + key);
            if (!el) return;
            var b = currentSettings[key];
            if (!b) return;

            el.style.fontFamily = b.font;
            el.style.fontSize = b.size + 'pt';

            var content = getBoxPreviewContent(key, currentSettings);
            el.innerHTML = content;

            if (key === 'logo1' || key === 'logo2' || key === 'barcode') {
                el.style.display = 'flex';
                el.style.alignItems = 'center';
                el.style.justifyContent = 'center';
                el.style.background = '#f8f9fa';
            } else if (key === 'ceo1' || key === 'ceo2') {
                el.style.display = 'flex';
                el.style.flexDirection = 'column';
                el.style.alignItems = 'center';
                el.style.justifyContent = 'center';
                el.style.background = '#fff';
                el.style.textAlign = 'center';
                el.style.lineHeight = '1.8';

                var sigPreview = el.querySelector('.cert-signature-img');
                if (sigPreview) {
                    var sigWidthKey = key === 'ceo1' ? 'ceo1SigWidth' : 'ceo2SigWidth';
                    var sigHeightKey = key === 'ceo1' ? 'ceo1SigHeight' : 'ceo2SigHeight';
                    var sigTopKey = key === 'ceo1' ? 'ceo1SigTopOffset' : 'ceo2SigTopOffset';
                    var sigLeftKey = key === 'ceo1' ? 'ceo1SigLeftOffset' : 'ceo2SigLeftOffset';
                    sigPreview.style.width = (currentSettings[sigWidthKey] || 60) + 'mm';
                    sigPreview.style.height = (currentSettings[sigHeightKey] || 25) + 'mm';
                    sigPreview.style.top = (currentSettings[sigTopKey] || 50) + '%';
                    sigPreview.style.left = (currentSettings[sigLeftKey] || 50) + '%';
                }
            } else {
                el.style.display = 'flex';
                el.style.alignItems = 'center';
                el.style.justifyContent = 'center';
                el.style.background = '#fff';
                el.style.textAlign = 'center';
            }
        }

        function refreshDependentBoxPreviews(textKey) {
            var map = {
                certTitle: ['title'],
                ceo1Name: ['ceo1'],
                ceo1Title: ['ceo1'],
                ceo2Name: ['ceo2'],
                ceo2Title: ['ceo2'],
                notice1: ['notice1'],
                notice2: ['notice2'],
                logo1Src: ['logo1'],
                logo2Src: ['logo2'],
                ceo1Sig: ['ceo1'],
                ceo2Sig: ['ceo2']
            };
            (map[textKey] || []).forEach(refreshBoxPreview);
        }

        function populateTextInputs(settings) {
            var map = {
                'text-certTitle': settings.texts.certTitle,
                'text-ceo1Name': settings.texts.ceo1Name,
                'text-ceo1Title': settings.texts.ceo1Title,
                'text-ceo2Name': settings.texts.ceo2Name,
                'text-ceo2Title': settings.texts.ceo2Title,
                'text-notice1': settings.texts.notice1,
                'text-notice2': settings.texts.notice2
            };
            Object.keys(map).forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.value = map[id] || '';
            });
        }

        function bindTextInputs() {
            var pairs = [
                ['text-certTitle', 'certTitle'],
                ['text-ceo1Name', 'ceo1Name'],
                ['text-ceo1Title', 'ceo1Title'],
                ['text-ceo2Name', 'ceo2Name'],
                ['text-ceo2Title', 'ceo2Title'],
                ['text-notice1', 'notice1'],
                ['text-notice2', 'notice2']
            ];
            pairs.forEach(function (pair) {
                var el = document.getElementById(pair[0]);
                if (el) {
                    el.addEventListener('input', function () {
                        currentSettings.texts[pair[1]] = el.value;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshDependentBoxPreviews(pair[1]);
                    });
                }
            });
        }

        function bindLogoUploads() {
            var input1 = document.getElementById('logo1UploadInput');
            var remove1 = document.getElementById('logo1RemoveBtn');
            if (input1) {
                input1.addEventListener('change', function () {
                    var file = input1.files && input1.files[0];
                    if (!file) return;
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        currentSettings.logo1Src = e.target.result;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview('logo1');
                    };
                    reader.readAsDataURL(file);
                });
            }
            if (remove1) {
                remove1.addEventListener('click', function () {
                    currentSettings.logo1Src = '';
                    if (input1) input1.value = '';
                    applySettings(currentSettings);
                    saveSettings(currentSettings);
                    refreshBoxPreview('logo1');
                });
            }

            var input2 = document.getElementById('logo2UploadInput');
            var remove2 = document.getElementById('logo2RemoveBtn');
            if (input2) {
                input2.addEventListener('change', function () {
                    var file = input2.files && input2.files[0];
                    if (!file) return;
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        currentSettings.logo2Src = e.target.result;
                        applySettings(currentSettings);
                        saveSettings(currentSettings);
                        refreshBoxPreview('logo2');
                    };
                    reader.readAsDataURL(file);
                });
            }
            if (remove2) {
                remove2.addEventListener('click', function () {
                    currentSettings.logo2Src = '';
                    if (input2) input2.value = '';
                    applySettings(currentSettings);
                    saveSettings(currentSettings);
                    refreshBoxPreview('logo2');
                });
            }
        }

